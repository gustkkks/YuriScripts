local function GetAnimate()
    local char = GetChar()
    return char and char:FindFirstChild("Animate")
end

local function StopAllAnims()
    pcall(function()
        local hum = GetHum()
        if hum then
            for _, t in ipairs(hum:GetPlayingAnimationTracks()) do t:Stop(0.1) end
        end
        local a = GetAnimate()
        if a then a.Disabled = false end
    end)
end

