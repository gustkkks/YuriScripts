Tabs.Move:Section({ ["Title"] = "Invisibility", ["Icon"] = "ghost" })

local InvisEnabled   = false
local InvisAnimId    = "2656374853"
local InvisAnim      = nil
local InvisHB        = nil
local InvisAnimBlock = nil
local InvisCollision = nil

local function SetTransparency(char, t)
    if not char then return end
    for _, name in ipairs({"Head","Torso","UpperTorso","LowerTorso","LeftArm","RightArm",
        "LeftLeg","RightLeg","LeftUpperArm","LeftLowerArm","LeftHand",
        "RightUpperArm","RightLowerArm","RightHand","LeftUpperLeg",
        "LeftLowerLeg","LeftFoot","RightUpperLeg","RightLowerLeg","RightFoot"}) do
        local p = char:FindFirstChild(name)
        if p and p:IsA("BasePart") then p.Transparency = t end
    end
end

local function StartInvis()
    local char = GetChar()
    if not char then return end
    local hum  = GetHum()
    local anim = hum and hum:FindFirstChildOfClass("Animator")
    if not hum or not anim then return end
    SetTransparency(char, 0.9)
    if InvisAnimBlock then InvisAnimBlock:Disconnect() end
    InvisAnimBlock = hum.AnimationPlayed:Connect(function(track)
        if not track.Animation.AnimationId:find(InvisAnimId) then track:Stop() end
    end)
    if InvisHB then InvisHB:Disconnect() end
    InvisHB = RunService.Heartbeat:Connect(function()
        if InvisEnabled and not (InvisAnim and InvisAnim.IsPlaying) then
            local a = Instance.new("Animation")
            a.AnimationId = "rbxassetid://" .. InvisAnimId
            InvisAnim = anim:LoadAnimation(a)
            InvisAnim:Play(); InvisAnim:AdjustSpeed(0)
        end
    end)
    if InvisCollision then InvisCollision:Disconnect() end
    InvisCollision = RunService.Stepped:Connect(function()
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                    p.CanCollide = false
                end
            end
        end
    end)
end

local function StopInvis()
    if InvisAnim      then InvisAnim:Stop(); InvisAnim = nil end
    if InvisAnimBlock then InvisAnimBlock:Disconnect(); InvisAnimBlock = nil end
    if InvisHB        then InvisHB:Disconnect(); InvisHB = nil end
    if InvisCollision then InvisCollision:Disconnect(); InvisCollision = nil end
    local char = GetChar()
    SetTransparency(char, 0)
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = true end
        end
    end
end

