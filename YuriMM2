        if cc then return cc end
    end
    return workspace:FindFirstChild("CoinContainer", true)
end

local function FindTargetCoin(root)
    local container = GetCoinContainer()
    if not container then return nil end
    local all = {}
    local nearest, nearDist = nil, math.huge
    for _, child in ipairs(container:GetChildren()) do
        local part = child:IsA("BasePart") and child
            or (child:IsA("Model") and child.PrimaryPart)
        if part and part ~= LastTeleportedCoin and part ~= CurrentWalkTarget then
            if CoinFarmMode == "Nearest" then
                local d = (root.Position - part.Position).Magnitude
                if d < nearDist then nearest = part; nearDist = d end
            else
                table.insert(all, part)
            end
        end
    end
    if CoinFarmMode == "Nearest" then return nearest end
    return #all > 0 and all[math.random(1, #all)] or nil
end

RunService.Heartbeat:Connect(function()
    if not CoinFarmEnabled then return end
    local root = GetRoot()
    local hum  = GetHum()
    if not root or not hum or hum.Health <= 0 then return end
    local now = os.clock()
    if TeleportWalk then
        if now - LastTeleportTime < TeleportInterval then
            if not (CurrentWalkTarget and CurrentWalkTarget.Parent) then
                local c = FindTargetCoin(root)
                if c then CurrentWalkTarget = c; hum:MoveTo(c.Position) end
            end
        else
            local coin = FindTargetCoin(root)
            if coin then
                root.CFrame = coin.CFrame
                LastTeleportedCoin = coin
                CurrentWalkTarget  = nil
                LastTeleportTime   = now
            end
        end
    else
        if now - LastTeleportTime >= TeleportInterval then
            local coin = FindTargetCoin(root)
            if coin then
                root.CFrame = coin.CFrame
                LastTeleportedCoin = coin
                LastTeleportTime   = now
            end
        end
    end
end)

