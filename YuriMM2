local ESPSettings = { Murder = false, Sheriff = false, Innocent = false }

local function GetRoleColor(role)
    if role == "Murder"   then return Color3.fromRGB(255, 0, 0) end
    if role == "Sheriff"  then return Color3.fromRGB(0, 150, 255) end
    return Color3.fromRGB(0, 255, 0)
end

local function GetPlayerRole(player)
    local murderer = GetMurderer()
    local sheriff  = GetSheriff()
    if player == murderer then return "Murder" end
    if player == sheriff  then return "Sheriff" end
    return "Innocent"
end

local function ClearESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then
            local h = p.Character:FindFirstChild("ESPHighlight")
            if h then h:Destroy() end
        end
    end
end

local function RefreshESP()
    ClearESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local role = GetPlayerRole(p)
            if ESPSettings[role] then
                local h = Instance.new("Highlight")
                h.Name             = "ESPHighlight"
                h.Adornee          = p.Character
                h.FillTransparency = 0.5
                h.DepthMode        = Enum.HighlightDepthMode.AlwaysOnTop
                h.FillColor        = GetRoleColor(role)
                h.OutlineColor     = GetRoleColor(role)
                h.Parent           = p.Character
            end
        end
    end
end

-- Listeners para atualizar ESP ao mudar de round
local function SetupPlayerESP(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        RefreshESP()
    end)
    local function connectBackpack()
        local bp = player:FindFirstChild("Backpack")
        if bp then
            bp.ChildAdded:Connect(RefreshESP)
            bp.ChildRemoved:Connect(RefreshESP)
        end
    end
    connectBackpack()
    player.ChildAdded:Connect(function(c)
        if c.Name == "Backpack" then connectBackpack() end
    end)
end

for _, p in pairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then SetupPlayerESP(p) end
end
Players.PlayerAdded:Connect(function(p) SetupPlayerESP(p) end)

