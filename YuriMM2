local SpinEnabled = false
local SpinSpeed   = 5
local SpinConn    = nil

FarmTab:AddToggle({
    Name        = "🌀 Spin (collect coins)",
    Description = "Gira o personagem para pegar moedas ao redor",
    Default     = false,
    Callback    = function(state)
        SpinEnabled = state
        if state then
            local root = GetRoot() or (LocalPlayer.CharacterAdded:Wait():WaitForChild("HumanoidRootPart"))
            SpinConn = RunService.RenderStepped:Connect(function()
                if SpinEnabled and root then
                    root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(SpinSpeed), 0)
                end
            end)
        else
            if SpinConn then SpinConn:Disconnect(); SpinConn = nil end
        end
    end,
})

