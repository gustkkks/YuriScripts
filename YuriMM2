local function Notify(title, body, duration)
    Library:Notify and Library:Notify({
        Title    = title,
        Content  = body,
        Duration = duration or 3,
    })
    -- fallback
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title    = title,
            Text     = body,
            Duration = duration or 3,
        })
    end)
end

