local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService   = game:GetService("TextChatService")

local function SendChat(msg)
    pcall(function()
        local tcs = TextChatService:FindFirstChild("TextChannels")
        if tcs and tcs:FindFirstChild("RBXGeneral") then
            tcs.RBXGeneral:SendAsync(msg); return
        end
        local cse = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if cse then cse.SayMessageRequest:FireServer(msg, "All") end
    end)
end

local function ExposeRole(weapon, roleName)
    for _, p in pairs(Players:GetPlayers()) do
        local c = p.Character
        local b = p:FindFirstChild("Backpack")
        if c and c:FindFirstChild(weapon) or b and b:FindFirstChild(weapon) then
            SendChat(roleName .. ": " .. p.Name)
            return true
        end
    end
    return false
end

