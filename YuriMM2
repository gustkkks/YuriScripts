local function ApplyAnim(pack)
    pcall(function()
        local a = GetAnimate()
        if not a then return end
        a.Disabled = true
        StopAllAnims()
        local base = "http://www.roblox.com/asset/?id="
        a.idle.Animation1.AnimationId = base .. pack[2]
        a.idle.Animation2.AnimationId = base .. pack[3]
        a.walk.WalkAnim.AnimationId   = base .. pack[4]
        a.run.RunAnim.AnimationId     = base .. pack[5]
        a.jump.JumpAnim.AnimationId   = base .. pack[6]
        a.climb.ClimbAnim.AnimationId = base .. pack[7]
        a.fall.FallAnim.AnimationId   = base .. pack[8]
        local hum = GetHum()
        if hum then hum:ChangeState(3) end
        a.Disabled = false
    end)
end

