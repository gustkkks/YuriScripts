local HitboxEnabled    = false
local HitboxSize       = 5
local HitboxColor      = Color3.new(1, 0, 0)
local HitboxAdornments = {}
local HitboxConn       = nil

local function UpdateHitboxes()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char  = p.Character
            local adorn = HitboxAdornments[p]
            if char and HitboxEnabled then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    if adorn then
                        adorn.Size   = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                        adorn.Color3 = HitboxColor
                    else
                        local box = Instance.new("BoxHandleAdornment")
                        box.Adornee      = root
                        box.Size         = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                        box.Color3       = HitboxColor
                        box.Transparency = 0.4
                        box.ZIndex       = 10
                        box.Parent       = root
                        HitboxAdornments[p] = box
                    end
                end
            elseif adorn then
                adorn:Destroy()
                HitboxAdornments[p] = nil
            end
        end
    end
end

