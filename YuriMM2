local FlyEnabled   = false
local FlySpeed     = 50
local FlyDir       = { f=0, b=0, l=0, r=0 }
local FlyConn      = nil
local FlyInpB      = nil
local FlyInpE      = nil

local function StopFly()
    FlyEnabled = false
    if FlyConn  then FlyConn:Disconnect();  FlyConn  = nil end
    if FlyInpB  then FlyInpB:Disconnect();  FlyInpB  = nil end
    if FlyInpE  then FlyInpE:Disconnect();  FlyInpE  = nil end
    pcall(function()
        local char = GetChar()
        if not char then return end
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        if torso then
            for _, c in ipairs(torso:GetChildren()) do
                if c.Name == "YuriFlyMover" then c:Destroy() end
            end
        end
        local hum = GetHum()
        if hum then hum.PlatformStand = false end
    end)
end

local function StartFly()
    local char  = GetChar()
    if not char then return end
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local hum   = GetHum()
    if not torso or not hum then return end
    for _, c in ipairs(torso:GetChildren()) do
        if c.Name == "YuriFlyMover" then c:Destroy() end
    end
    local bg = Instance.new("BodyGyro", torso)
    bg.Name = "YuriFlyMover"; bg.P = 20000
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.CFrame = torso.CFrame
    local bv = Instance.new("BodyVelocity", torso)
    bv.Name = "YuriFlyMover"
    bv.Velocity  = Vector3.new(0, 0.1, 0)
    bv.MaxForce  = Vector3.new(math.huge, math.huge, math.huge)
    FlyConn = RunService.Heartbeat:Connect(function()
        if not FlyEnabled or hum:GetState() == Enum.HumanoidStateType.Dead then
            StopFly(); return
        end
        hum.PlatformStand = true
        local cam = workspace.CurrentCamera
        local dir = Vector3.new(FlyDir.l + FlyDir.r, 0, FlyDir.f + FlyDir.b)
        bv.Velocity = dir.Magnitude > 0
            and cam.CFrame:VectorToWorldSpace(dir).Unit * FlySpeed
            or Vector3.new(0, 0.1, 0)
        bg.CFrame = cam.CFrame
    end)
    FlyInpB = UserInputService.InputBegan:Connect(function(inp, gp)
        if gp then return end
        local k = inp.KeyCode.Name:lower()
        if k == "w" then FlyDir.f = -1
        elseif k == "s" then FlyDir.b = 1
        elseif k == "a" then FlyDir.l = -1
        elseif k == "d" then FlyDir.r = 1 end
    end)
    FlyInpE = UserInputService.InputEnded:Connect(function(inp)
        local k = inp.KeyCode.Name:lower()
        if k == "w" then FlyDir.f = 0
        elseif k == "s" then FlyDir.b = 0
        elseif k == "a" then FlyDir.l = 0
        elseif k == "d" then FlyDir.r = 0 end
    end)
end

