local TeleportTab = Window:MakeTab({ Title = "Teleport", Icon = "Map" })
TeleportTab:AddSection("Player Teleport")

local SelectedPlayer = nil

TeleportTab:AddTextBox({
    Name        = "Player Name",
    Placeholder = "Enter player name...",
    ClearOnFocus = true,
    Callback    = function(text)
        if text == "" then SelectedPlayer = nil; return end
        local lower = text:lower()
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name:lower():find(lower, 1, true)
                or p.DisplayName:lower():find(lower, 1, true)
            then
                SelectedPlayer = p
                Notify("Player Selected", "Selected: " .. p.DisplayName, 3)
                return
            end
        end
        Notify("Not Found", "Player not found: " .. text, 3)
    end,
})

TeleportTab:AddButton({
    Name     = "📍 Teleport to Player",
    Debounce = 1,
    Callback = function()
        if not SelectedPlayer then Notify("No Player", "Select a player first", 2); return end
        local root  = GetRoot()
        local tRoot = SelectedPlayer.Character and SelectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root and tRoot then
            root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
        end
    end,
})

TeleportTab:AddButton({
    Name     = "👁️ Spectate Player",
