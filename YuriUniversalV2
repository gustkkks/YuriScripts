-- FUNÇÕES AUXILIARES
local function GetTeamColor(Player)
	local cor = nil
	pcall(function()
		if Player.TeamColor then cor = Player.TeamColor.Color end
	end)
	if not cor then
		pcall(function()
			if Player.Team and Player.Team.TeamColor then cor = Player.Team.TeamColor.Color end
		end)
	end
	return cor or Settings.ESPColor
end

local function IsAlive(Player)
	local char = Player.Character
	if not char then return false end
	local hum = char:FindFirstChild("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	return hum ~= nil and root ~= nil and hum.Health > 0
end

local function IsTeamWhitelisted(Player)
	local teamName = nil
	pcall(function() if Player.Team then teamName = Player.Team.Name end end)
	return teamName and Settings.TeamWhitelist[teamName] == true
end

local function IsOnSameTeam(Player)
	if IsTeamWhitelisted(Player) then return true end
	if not Settings.CheckTeam then return false end
	local same = false
	pcall(function()
		if LocalPlayer.TeamColor and Player.TeamColor and LocalPlayer.TeamColor == Player.TeamColor then same = true end
	end)
	if same then return true end
	pcall(function()
		if LocalPlayer.Team and Player.Team and LocalPlayer.Team == Player.Team then same = true end
	end)
	return same
end

-- ISVISIBLE OTIMIZADO COM CACHE
local function IsVisible(Part)
	if not Settings.CheckWall then return true end
	if not Part then return false end
	local Key = Part.Position
	local Cached = VisibilityCache[Key]
	if Cached and Cached.Frame == FrameCount then return Cached.Visible end
	local origin = Camera.CFrame.Position
	local target = Part.Position
	local direction = (target - origin).Unit
	local distance = (target - origin).Magnitude
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = { LocalPlayer.Character, Camera }
	local result = workspace:Raycast(origin, direction * distance, params)
	local visible = false
	if not result then
		visible = true
	else
		if Players:GetPlayerFromCharacter(result.Instance.Parent) then visible = true end
		local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
		if hitModel and hitModel:FindFirstChild("Humanoid") then visible = true end
	end
	VisibilityCache[Key] = { Frame = FrameCount, Visible = visible }
	return visible
end

-- GET NEAREST TARGET OTIMIZADO (CACHE DE 0.1s)
local function GetNearestTarget()
	local Now = tick()
	if CachedTarget and Now - TargetUpdateTick < 0.1 then
		if IsAlive(CachedTarget) and not IsTeamWhitelisted(CachedTarget) then
			local root = CachedTarget.Character and CachedTarget.Character:FindFirstChild("HumanoidRootPart")
			if root and IsVisible(root) then return CachedTarget end
		end
	end
	TargetUpdateTick = Now
	local closest = nil
	local closestDist = Settings.FovRadius
	local viewport = Camera.ViewportSize
	local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		if not IsAlive(player) then continue end
		if IsOnSameTeam(player) then continue end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root then continue end
		if not IsVisible(root) then continue end
		local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
		if not onScreen then continue end
		local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
		if dist < closestDist then
			closest = player
			closestDist = dist
		end
	end
	CachedTarget = closest
	return closest
end

-- PEGAR TIMES DO SERVIDOR
local function GetServerTeams()
	local teams = {}
	local seen = {}
	pcall(function()
		for _, team in ipairs(game:GetService("Teams"):GetTeams()) do
			if not seen[team.Name] then seen[team.Name] = true; table.insert(teams, team.Name) end
		end
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		pcall(function()
			if player.Team and not seen[player.Team.Name] then seen[player.Team.Name] = true; table.insert(teams, player.Team.Name) end
		end)
	end
	return teams
end

-- LOOP PRINCIPAL OTIMIZADO (ÚNICO RenderStepped)
RunService.RenderStepped:Connect(function()
	FrameCount = FrameCount + 1
	
	-- MOVIMENTO
	local char = LocalPlayer.Character
	if char then
		local hum = char:FindFirstChild("Humanoid")
		if hum then
			if Settings.SpeedEnabled then hum.WalkSpeed = Settings.SpeedAmount end
			if Settings.JumpEnabled then hum.JumpPower = Settings.JumpAmount end
		end
		if Settings.NoClip then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then part.CanCollide = false end
			end
		end
	end
	
	-- FOV CIRCLE
	if Settings.FovEnabled and Settings.AimbotEnabled then
		FovCircle.Visible = true; FovCircle.Position = Camera.ViewportSize / 2
		FovCircle.Radius = Settings.FovRadius; FovCircle.Color = Settings.FovColor
		FovCircle.Transparency = Settings.FovFilled and 0.5 or 0.7; FovCircle.Filled = Settings.FovFilled
	else
		FovCircle.Visible = false
	end
	
	-- AIMBOT
	if Settings.AimbotEnabled then
		local canAim = Settings.AimbotOnMobile or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
		if canAim then
			local target = GetNearestTarget()
			if target and target.Character then
				local head = target.Character:FindFirstChild("Head")
				local root = target.Character:FindFirstChild("HumanoidRootPart")
				local aimPos = (head and head.Position) or (root and root.Position)
				if aimPos then
					local smooth = Settings.AimbotSmoothness
					if smooth > 0 then
						local currentLook = Camera.CFrame.LookVector
						local targetDir = (aimPos - Camera.CFrame.Position).Unit
						local factor = 1 / (smooth * 0.5 + 1)
						local smoothDir = currentLook:Lerp(targetDir, factor)
						Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, Camera.CFrame.Position + smoothDir * 100)
					else
						Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, aimPos)
					end
				end
			end
		end
	end
	
	-- ESP (a cada 2 frames)
	if FrameCount % 2 == 0 then
		for player, esp in pairs(ESPObjects) do
			local function hide() esp.Box.Visible = false; esp.Line.Visible = false; esp.Tracer.Visible = false end
			if not Settings.ESPEnabled then hide() continue end
			if not Players:FindFirstChild(player.Name) then hide() continue end
			if not IsAlive(player) then hide() continue end
			if not IsTeamWhitelisted(player) and IsOnSameTeam(player) then hide() continue end
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local head = char and char:FindFirstChild("Head")
			local hum = char and char:FindFirstChild("Humanoid")
			if not root or not head or not hum or hum.Health <= 0 then hide() continue end
			local teamColor = GetTeamColor(player)
			local espColor = Settings.ESPUseTeamColor and teamColor or Settings.ESPColor
			local rootPos, onScreen = Camera:WorldToViewportPoint(root.Position)
			local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
			local legPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
			if not onScreen then hide() continue end
			local boxH = headPos.Y - legPos.Y; local boxW = boxH * 0.6
			if Settings.BoxEnabled then
				esp.Box.Visible = true; esp.Box.Size = Vector2.new(boxW, boxH)
				esp.Box.Position = Vector2.new(rootPos.X - boxW / 2, headPos.Y); esp.Box.Color = espColor
			else esp.Box.Visible = false end
			if Settings.LineEnabled then
				esp.Line.Visible = true; esp.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
				esp.Line.To = Vector2.new(rootPos.X, rootPos.Y); esp.Line.Color = espColor
			else esp.Line.Visible = false end
			if Settings.TracerEnabled then
				esp.Tracer.Visible = true; esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, 0)
				esp.Tracer.To = Vector2.new(rootPos.X, rootPos.Y); esp.Tracer.Color = espColor
			else esp.Tracer.Visible = false end
		end
	end
	
	-- Limpa cache de visibilidade a cada 30 frames
	if FrameCount % 30 == 0 then VisibilityCache = {} end
end)

-- CLIP
local ClipConnection = nil
local function ToggleClip(state)
	Settings.ClipEnabled = state
	if ClipConnection then ClipConnection:Disconnect() ClipConnection = nil end
	if state then
		ClipConnection = RunService.RenderStepped:Connect(function()
			local char = LocalPlayer.Character
			if not char then return end
			local root = char:FindFirstChild("HumanoidRootPart")
			if root then root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z) end
		end)
	end
end

