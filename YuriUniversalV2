-- ESP OBJECTS
local ESPObjects = {}
local function CriarESP(player)
	if ESPObjects[player] then return end
	local entry = { Box = Drawing.new("Square"), Line = Drawing.new("Line"), Tracer = Drawing.new("Line") }
	entry.Box.Visible = false; entry.Box.Thickness = 1; entry.Box.Filled = false; entry.Box.Transparency = 1
	entry.Line.Visible = false; entry.Line.Thickness = 1; entry.Line.Transparency = 1
	entry.Tracer.Visible = false; entry.Tracer.Thickness = 1; entry.Tracer.Transparency = 1
	ESPObjects[player] = entry
end
for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then CriarESP(p) end end
Players.PlayerAdded:Connect(function(p) if p ~= LocalPlayer then CriarESP(p) end end)

