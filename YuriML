local function AutoTool(toolName, flagVar)
    task.spawn(function()
        local bp = LocalPlayer:FindFirstChild("Backpack")
        while _G[flagVar] do
            task.wait(0.01)
            local tool = bp and bp:FindFirstChild(toolName)
            if tool then
                local hum = GetHum()
                if hum then hum:EquipTool(tool) end
            end
            LocalPlayer.muscleEvent:FireServer("rep")
        end
        local char = GetChar()
        if char then
            local eq = char:FindFirstChildOfClass("Tool")
            if eq and eq.Name == toolName then
                eq.Parent = LocalPlayer:FindFirstChild("Backpack")
            end
        end
    end)
end

