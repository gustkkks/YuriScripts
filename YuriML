local rockStates = {}

local function StartRock(machineName, flagKey)
    task.spawn(function()
        local char    = GetChar() or LocalPlayer.CharacterAdded:Wait()
        local lHand   = char:WaitForChild("LeftHand")
        local machine = workspace.machinesFolder:FindFirstChild(machineName)
        local rock    = machine and machine:FindFirstChild("Rock")
        _G[flagKey] = true
        while _G[flagKey] do
            if rock then
                rock.Size         = Vector3.new(2, 1, 1)
                rock.Transparency = 1
                rock.CanCollide   = false
                for _, child in ipairs(rock.rockGui:GetChildren()) do
                    child.Visible = false
                end
                for _, pname in ipairs({"rockEmitter","hoopParticle","lavaParticle"}) do
                    local p = rock:FindFirstChild(pname)
                    if p then p:Destroy() end
                end
                rock.CFrame = lHand.CFrame
            end
            task.wait()
        end
    end)
end

local function StopRock(machineName, flagKey, origSize)
    _G[flagKey] = false
    pcall(function()
        local machine = workspace.machinesFolder:FindFirstChild(machineName)
        local rock    = machine and machine:FindFirstChild("Rock")
        if rock then
            for _, child in ipairs(rock.rockGui:GetChildren()) do
                child.Visible = true
            end
            rock.CanCollide   = true
            rock.Transparency = 0
            rock.Size         = origSize
            rock.CFrame       = CFrame.new(rock.originalPosition.Value)
        end
    end)
end

