local selectedTP = nil

local tpValues = {}
for _, entry in ipairs(teleportLocations) do
    table.insert(tpValues, entry[1])
end

Tabs.TP:Dropdown({
    ["Title"]    = "Select Location",
    ["Values"]   = tpValues,
    ["Value"]    = tpValues[1],
    ["Callback"] = function(v)
        for _, entry in ipairs(teleportLocations) do
            if entry[1] == v then selectedTP = entry[2]; break end
        end
    end
