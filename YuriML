Tabs.Pets:Section({ ["Title"] = "Sell Pet", ["Icon"] = "trash" })

local sellPetName = nil

Tabs.Pets:Input({
    ["Title"]       = "Pet Name to Sell",
    ["Placeholder"] = "Enter exact pet name...",
    ["Callback"]    = function(v)
        sellPetName = (v ~= "" and v) or nil
    end
})

Tabs.Pets:Button({
    ["Title"]    = "Sell Pet",
    ["Callback"] = function()
        if sellPetName then
            pcall(function()
                ReplicatedStorage.rEvents.sellPetEvent:FireServer("sellPet", sellPetName)
                SendNotif("Pets", "Sold: " .. sellPetName, 3)
            end)
            sellPetName = nil
        else
            SendNotif("Error", "Enter a pet name first!", 3)
        end
    end
})

