Tabs.Player:Section({ ["Title"] = "Fly", ["Icon"] = "wind" })

local flyEnabled = false; local flySpeed = 50
local flyDir = {f=0,b=0,l=0,r=0}
local flyConn,flyInpB,flyInpE = nil,nil,nil

local UserInputService = game:GetService("UserInputService")

local function StopFly()
    flyEnabled=false
    if flyConn  then flyConn:Disconnect();  flyConn=nil  end
    if flyInpB  then flyInpB:Disconnect();  flyInpB=nil  end
    if flyInpE  then flyInpE:Disconnect();  flyInpE=nil  end
    pcall(function()
        local char=GetChar(); if not char then return end
        local torso=char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        if torso then for _,c in ipairs(torso:GetChildren()) do if c.Name=="YuriFlyMover" then c:Destroy() end end end
        local h=GetHum(); if h then h.PlatformStand=false end
    end)
end

local function StartFly()
    local char=GetChar(); if not char then return end
    local torso=char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local hum=GetHum(); if not torso or not hum then return end
    for _,c in ipairs(torso:GetChildren()) do if c.Name=="YuriFlyMover" then c:Destroy() end end
    local bg=Instance.new("BodyGyro",torso); bg.Name="YuriFlyMover"; bg.P=20000
    bg.MaxTorque=Vector3.new(math.huge,math.huge,math.huge); bg.CFrame=torso.CFrame
    local bv=Instance.new("BodyVelocity",torso); bv.Name="YuriFlyMover"
    bv.Velocity=Vector3.new(0,0.1,0); bv.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
    flyConn=RunService.Heartbeat:Connect(function()
        if not flyEnabled or hum:GetState()==Enum.HumanoidStateType.Dead then StopFly(); return end
        hum.PlatformStand=true
        local cam=workspace.CurrentCamera
        local dir=Vector3.new(flyDir.l+flyDir.r,0,flyDir.f+flyDir.b)
        bv.Velocity=dir.Magnitude>0 and cam.CFrame:VectorToWorldSpace(dir).Unit*flySpeed or Vector3.new(0,0.1,0)
        bg.CFrame=cam.CFrame
    end)
    flyInpB=UserInputService.InputBegan:Connect(function(inp,gp)
        if gp then return end; local k=inp.KeyCode.Name:lower()
        if k=="w" then flyDir.f=-1 elseif k=="s" then flyDir.b=1
        elseif k=="a" then flyDir.l=-1 elseif k=="d" then flyDir.r=1 end
    end)
    flyInpE=UserInputService.InputEnded:Connect(function(inp)
        local k=inp.KeyCode.Name:lower()
        if k=="w" then flyDir.f=0 elseif k=="s" then flyDir.b=0
        elseif k=="a" then flyDir.l=0 elseif k=="d" then flyDir.r=0 end
    end)
end

