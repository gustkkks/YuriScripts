-- =============================================
-- FUNÇÕES DE MOVIMENTO
-- =============================================
local function TeleportTo(cf)
    local char = GetChar()
    if char and char.PrimaryPart then
        char:SetPrimaryPartCFrame(cf)
    end
end

local function Tween(cf)
    local root = GetRoot()
    local hum  = GetHum()
    if not root or not cf then return end
    Distance = (cf.Position - root.Position).Magnitude
    if Distance <= 150 then
        root.CFrame = cf; return
    end
    pcall(function()
        tween = TweenService:Create(root, TweenInfo.new(Distance / 300, Enum.EasingStyle.Linear), { CFrame = cf })
        tween:Play()
    end)
    wait(Distance / 300)
end

local function TP2(cf)
    local root = GetRoot()
    if not root or not cf then return end
    local dist = (cf.Position - root.Position).Magnitude
    local spd = dist >= 1 and 150 or Speed
    local tw = TweenService:Create(root, TweenInfo.new(dist / spd, Enum.EasingStyle.Linear), { CFrame = cf })
    tw:Play()
    _G.Clip2 = true
    wait(dist / spd)
    _G.Clip2 = false
end

local function EquipTool(name)
    if not name then return end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        local tool = bp:FindFirstChild(name)
        if tool then
            wait(0.1)
            local hum = GetHum()
            if hum then hum:EquipTool(tool) end
        end
    end
end

local function Click()
    if not FastAttack then
        pcall(function()
            local fw = debug.getupvalues(require(LocalPlayer.PlayerScripts.CombatFramework))[2]
            require(ReplicatedStorage.Util.CameraShaker):Stop()
            fw.activeController.attacking = false
            fw.activeController.timeToNextAttack = 0
            fw.activeController.hitboxMagnitude = 180
        end)
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(1280, 672))
    end
end

local function InMyNetWork(part)
    if isnetworkowner then return isnetworkowner(part) end
    local root = GetRoot()
    if root and (part.Position - root.Position).Magnitude <= 350 then return true end
    return false
end

local function BTP(cf)
    -- Bypass teleport: usa BodyVelocity para mover gradualmente
    pcall(function()
        local root = GetRoot()
        if not root then return end
        root.CFrame = cf
    end)
end

