    FovCircle.Transparency = Settings.FovFilled and 0.5 or 0.7
    FovCircle.Filled       = Settings.FovFilled
end)

-- =============================================
-- ESP
-- =============================================
type ESPEntry = { Box: any, Line: any, Tracer: any }
local ESPObjects: { [Player]: ESPEntry } = {}

local function CriarESP(player: Player)
    if ESPObjects[player] then return end
    local entry: ESPEntry = {
        Box    = Drawing.new("Square"),
        Line   = Drawing.new("Line"),
        Tracer = Drawing.new("Line"),
    }
    entry.Box.Visible    = false; entry.Box.Thickness    = 1
    entry.Box.Filled     = false; entry.Box.Transparency = 1
    entry.Line.Visible   = false; entry.Line.Thickness   = 1; entry.Line.Transparency   = 1
    entry.Tracer.Visible = false; entry.Tracer.Thickness = 1; entry.Tracer.Transparency = 1
    ESPObjects[player] = entry
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then CriarESP(p) end
end
Players.PlayerAdded:Connect(function(p)
    if p ~= LocalPlayer then CriarESP(p) end
end)

RunService.RenderStepped:Connect(function()
    for player, esp in pairs(ESPObjects) do
        local hide = function()
            esp.Box.Visible    = false
            esp.Line.Visible   = false
            esp.Tracer.Visible = false
        end

        if not Settings.ESPEnabled then hide() continue end
        if not Players:FindFirstChild(player.Name) then hide() continue end
        if not IsAlive(player) then hide() continue end
        if IsOnSameTeam(player) then hide() continue end -- inclui whitelist

        local char  = player.Character
        local root  = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
        local head  = char and char:FindFirstChild("Head")             :: BasePart?
        local hum   = char and char:FindFirstChild("Humanoid")         :: Humanoid?

        if not root or not head or not hum or hum.Health <= 0 then hide() continue end

        local teamColor = GetTeamColor(player)
        local espColor  = Settings.ESPUseTeamColor and teamColor or Settings.ESPColor

        local rootPos,  onScreen = Camera:WorldToViewportPoint(root.Position)
        local headPos            = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        local legPos             = Camera:WorldToViewportPoint(root.Position  - Vector3.new(0, 3, 0))

        if not onScreen then hide() continue end

        local boxH = headPos.Y - legPos.Y
        local boxW = boxH * 0.6

        if Settings.BoxEnabled then
            esp.Box.Visible  = true
            esp.Box.Size     = Vector2.new(boxW, boxH)
            esp.Box.Position = Vector2.new(rootPos.X - boxW / 2, headPos.Y)
            esp.Box.Color    = espColor
        else
            esp.Box.Visible = false
        end

        if Settings.LineEnabled then
            esp.Line.Visible = true
            esp.Line.From    = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            esp.Line.To      = Vector2.new(rootPos.X, rootPos.Y)
            esp.Line.Color   = espColor
        else
            esp.Line.Visible = false
        end

        if Settings.TracerEnabled then
            esp.Tracer.Visible = true
            esp.Tracer.From    = Vector2.new(Camera.ViewportSize.X / 2, 0)
            esp.Tracer.To      = Vector2.new(rootPos.X, rootPos.Y)
            esp.Tracer.Color   = espColor
        else
            esp.Tracer.Visible = false
        end
    end
end)

