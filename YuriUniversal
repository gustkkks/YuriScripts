RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid") :: Humanoid?
    if not hum then return end

    -- Só modifica quando ATIVADO — não interfere com o jogo quando desligado
    if Settings.SpeedEnabled then
        hum.WalkSpeed = Settings.SpeedAmount
    end
    if Settings.JumpEnabled then
        hum.JumpPower = Settings.JumpAmount
    end

    if Settings.NoClip then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                (part :: BasePart).CanCollide = false
            end
        end
    end
end)

-- CLIP
local ClipConnection: RBXScriptConnection? = nil
local function ToggleClip(state: boolean)
    Settings.ClipEnabled = state
    if ClipConnection then
        ClipConnection:Disconnect()
        ClipConnection = nil
    end
    if state then
        ClipConnection = RunService.RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
            if root then
                root.AssemblyLinearVelocity = Vector3.new(
                    root.AssemblyLinearVelocity.X,
                    0,
                    root.AssemblyLinearVelocity.Z
                )
            end
        end)
    end
end

-- =============================================
-- AIMBOT
-- =============================================
local AimbotConnection: RBXScriptConnection? = nil

local function AtualizarAimbot()
    if AimbotConnection then
        AimbotConnection:Disconnect()
        AimbotConnection = nil
    end
    if not Settings.AimbotEnabled then return end

    AimbotConnection = RunService.RenderStepped:Connect(function()
        local canAim = Settings.AimbotOnMobile
            or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        if not canAim then return end

        local target = GetNearestTarget()
        if not target then return end

        local head  = target.Character and target.Character:FindFirstChild("Head")   :: BasePart?
        local root  = target.Character and target.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
        local aimPos = (head and head.Position) or (root and root.Position)
        if not aimPos then return end

        local smooth = Settings.AimbotSmoothness
        if smooth > 0 then
            local currentLook = Camera.CFrame.LookVector
            local targetDir   = (aimPos - Camera.CFrame.Position).Unit
            local factor      = 1 / (smooth * 0.5 + 1)
            local smoothDir   = currentLook:Lerp(targetDir, factor)
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, Camera.CFrame.Position + smoothDir * 100)
        else
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, aimPos)
        end
    end)
end

