-- =============================================
-- FUNÇÕES AUXILIARES
-- =============================================
local function GetTeamColor(Player: Player): Color3
    local cor: Color3? = nil
    pcall(function()
        if Player.TeamColor then
            cor = Player.TeamColor.Color
        end
    end)
    if not cor then
        pcall(function()
            if Player.Team and Player.Team.TeamColor then
                cor = Player.Team.TeamColor.Color
            end
        end)
    end
    return cor or Settings.ESPColor
end

local function IsAlive(Player: Player): boolean
    local char = Player.Character
    if not char then return false end
    local hum  = char:FindFirstChild("Humanoid") :: Humanoid?
    local root = char:FindFirstChild("HumanoidRootPart")
    return hum ~= nil and root ~= nil and hum.Health > 0
end

-- Verifica se o time do jogador está na whitelist
local function IsTeamWhitelisted(Player: Player): boolean
    local teamName: string? = nil
    pcall(function()
        if Player.Team then
            teamName = Player.Team.Name
        end
    end)
    if teamName and Settings.TeamWhitelist[teamName] then
        return true
    end
    return false
end

local function IsOnSameTeam(Player: Player): boolean
    -- Whitelist tem prioridade — trata como aliado
    if IsTeamWhitelisted(Player) then return true end
    if not Settings.CheckTeam then return false end

    local same = false
    pcall(function()
        if LocalPlayer.TeamColor and Player.TeamColor
            and LocalPlayer.TeamColor == Player.TeamColor then
            same = true
        end
    end)
    if same then return true end
    pcall(function()
        if LocalPlayer.Team and Player.Team
            and LocalPlayer.Team == Player.Team then
            same = true
        end
    end)
    return same
end

local function IsVisible(Part: BasePart): boolean
    if not Settings.CheckWall then return true end
    if not Part then return false end
    local origin    = Camera.CFrame.Position
    local target    = Part.Position
    local direction = (target - origin).Unit
    local distance  = (target - origin).Magnitude
    local params    = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = { LocalPlayer.Character, Camera }
    local result = workspace:Raycast(origin, direction * distance, params)
    if not result then return true end
    if Players:GetPlayerFromCharacter(result.Instance.Parent) then return true end
    local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
    if hitModel and hitModel:FindFirstChild("Humanoid") then return true end
    return false
end

local function GetNearestTarget(): Player?
    local closest: Player?        = nil
    local closestDist: number     = Settings.FovRadius
    local viewport                = Camera.ViewportSize
    local center                  = Vector2.new(viewport.X / 2, viewport.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not IsAlive(player) then continue end
        if IsOnSameTeam(player) then continue end
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
        if not root then continue end
        if not IsVisible(root) then continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist < closestDist then
            closest     = player
            closestDist = dist
        end
    end
    return closest
end

-- =============================================
-- PEGAR TIMES DO SERVIDOR
-- =============================================
local function GetServerTeams(): { string }
    local teams: { string } = {}
    local seen: { [string]: boolean } = {}

    -- Via Teams service
    pcall(function()
        for _, team in ipairs(game:GetService("Teams"):GetTeams()) do
            if not seen[team.Name] then
                seen[team.Name] = true
                table.insert(teams, team.Name)
            end
        end
    end)

    -- Fallback: varre jogadores (jogos sem Teams service)
    for _, player in ipairs(Players:GetPlayers()) do
        pcall(function()
            if player.Team and not seen[player.Team.Name] then
                seen[player.Team.Name] = true
                table.insert(teams, player.Team.Name)
            end
        end)
    end

    return teams
end

