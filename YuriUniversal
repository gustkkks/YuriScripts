local WhitelistTab = Window:MakeTab({ Title = Tr("tab_wl"), Icon = "Shield" })
WhitelistTab:AddSection(Tr("sec_wl"))
WhitelistTab:AddParagraph(Tr("par_wl_title"), Tr("par_wl_body"))

-- Pega os times iniciais
local initialTeams = GetServerTeams()
if #initialTeams == 0 then
    initialTeams = { Tr("drop_wl_empty") }
end

-- Dropdown multi-select: cada opção = um time do servidor
-- Selecionar = ignorar aquele time no aimbot/ESP
local WhitelistDropdown = WhitelistTab:AddDropdown({
    Name        = Tr("drop_wl"),
    Options     = initialTeams,
    MultiSelect = true,
    Default     = {},
    Callback    = function(selected)
        -- MultiSelect retorna uma tabela { [nome] = true } ou { string }
        -- A Wand UI retorna tabela de strings, cobrimos os dois casos
        Settings.TeamWhitelist = {}
        if type(selected) == "table" then
            for k, v in pairs(selected) do
                if type(k) == "string" and v == true then
                    -- formato { [nome] = true }
                    Settings.TeamWhitelist[k] = true
                elseif type(v) == "string" then
                    -- formato { [1] = "nome", ... }
                    Settings.TeamWhitelist[v] = true
                end
            end
        end
    end,
})

WhitelistTab:AddButton({
    Name     = Tr("btn_wl_refresh"),
    Debounce = 2,
    Callback = function()
        local teams = GetServerTeams()
        if #teams == 0 then
            teams = { Tr("drop_wl_empty") }
        end
        -- Limpa e repovooa o dropdown com a API oficial da library
        WhitelistDropdown:Clear()
        WhitelistDropdown:NewOptions(teams)
        -- Reseta whitelist (seleções antigas podem não existir mais)
        Settings.TeamWhitelist = {}
        local msg = Tr("msg_wl_update")
        for i, name in ipairs(teams) do
            msg ..= name .. (i < #teams and ", " or "")
        end
        print(msg)
    end,
})

WhitelistTab:AddParagraph(Tr("par_wl_hint"), Tr("par_wl_hint_b"))

