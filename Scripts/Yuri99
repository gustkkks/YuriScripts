local function tp1() -- Campfire
    local root = GetRoot()
    if root then root.CFrame = CFrame.new(0, 19, 0) end
end

local function tp2() -- Stronghold
    local root = GetRoot()
    if root then root.CFrame = CFrame.new(-230, 20, 0) end
end

local function getMobs()
    local mobs, names = {}, {}
    local chars = Workspace:FindFirstChild("Characters")
    if chars then
        for _, m in ipairs(chars:GetChildren()) do
            if m:IsA("Model") then
                table.insert(mobs, m)
                table.insert(names, m.Name)
            end
        end
    end
    return mobs, names
end

local function getChests()
    local chests, names = {}, {}
    local items = Workspace:FindFirstChild("Items")
    if items then
        for _, item in ipairs(items:GetChildren()) do
            if item.Name:lower():find("chest") then
                table.insert(chests, item)
                table.insert(names, item.Name)
            end
        end
    end
    return chests, names
end

local function tpToRandomTree()
    local root = GetRoot()
    if not root then return end
    local map = Workspace:FindFirstChild("Map")
    if not map then return end
    local folder = map:FindFirstChild("Foliage") or map:FindFirstChild("Landmarks")
    if not folder then return end
    local trees = {}
    for _, tree in ipairs(folder:GetChildren()) do
        if tree.Name == "Small Tree" and tree:IsA("Model") then
            local trunk = tree:FindFirstChild("Trunk") or tree.PrimaryPart
            if trunk then table.insert(trees, trunk) end
        end
    end
    if #trees > 0 then
        local cf = trees[math.random(1, #trees)].CFrame
        root.CFrame = CFrame.new(cf.Position + cf.RightVector * 3)
    end
end

-- =============================================
-- PLANTING
-- =============================================
local function generatePlantingPositions(count)
    local root = GetRoot()
    if not root then return {} end
    local center = root.Position + Vector3.new(0, plantingHeight, 0)
    local positions = {}
    if placementMethod == "Circle" then
        for i = 0, count-1 do
            local angle = i * plantingAngle
            table.insert(positions, center + Vector3.new(
                math.cos(angle) * plantingRadius, 0, math.sin(angle) * plantingRadius
            ))
        end
    else
        local side = math.ceil(math.sqrt(count))
        local step = plantingRadius * 2 / side
        local idx = 0
        for row = 0, side-1 do
            for col = 0, side-1 do
                if idx < count then
                    table.insert(positions, center + Vector3.new(
                        -plantingRadius + col * step, 0, -plantingRadius + row * step
                    ))
                    idx = idx + 1
                end
            end
        end
    end
    return positions
end

-- =============================================
-- FLY WALK
-- =============================================
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Blacklist

local function updateFlyWalk()
    local root = GetRoot()
    if not root or not flyWalkEnabled then return end
    local res = Workspace:Raycast(root.Position, Vector3.new(0,-1000,0), rayParams)
    if res then
        local targetY = res.Position.Y + flyWalkHeight + 3
        local cf = root.CFrame
        root.CFrame = CFrame.new(cf.Position.X, targetY, cf.Position.Z) * CFrame.fromOrientation(cf:ToOrientation())
    end
end

LocalPlayer.CharacterAdded:Connect(function(char)
    rayParams.FilterDescendantsInstances = {char}
    if flyWalkEnabled then
        task.wait(1)
        flyWalkConn = RunService.Heartbeat:Connect(updateFlyWalk)
    end
end)

-- =============================================
-- SPEED (V key)
-- =============================================
local function toggleSpeed(state)
    speedEnabled = state
    getgenv().WalkspeedBypass = state
    if state then
        task.spawn(function()
            local char = GetChar() or LocalPlayer.CharacterAdded:Wait()
            while getgenv().WalkspeedBypass and char and char.Parent do
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.MoveDirection.Magnitude > 0 then
                    char:TranslateBy(hum.MoveDirection * speedValue * RunService.Heartbeat:Wait() * 7)
                else
                    task.wait()
                end
            end
        end)
    end
end

UserInputService.InputBegan:Connect(function(input, gp)
    if input.KeyCode == Enum.KeyCode.V and not gp then
        toggleSpeed(not speedEnabled)
    end
end)

UserInputService.JumpRequest:Connect(function()
    if infJumpEnabled then
        local hum = GetHum()
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

