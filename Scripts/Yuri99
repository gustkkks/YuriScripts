-- =============================================
-- TAB: MAIN (ESP)
-- =============================================
Tabs.Main:Section({ ["Title"] = "ESP Items", ["Icon"] = "package" })

local selectedItemsESP = {}
local itemESPEnabled   = false
local itemESPConn      = nil

Tabs.Main:Dropdown({
    ["Title"]    = "Select Items for ESP",
    ["Values"]   = allItems,
    ["Value"]    = {},
    ["Multi"]    = true,
    ["Callback"] = function(selected)
        selectedItemsESP = selected
        if itemESPEnabled then
            for _, name in ipairs(allItems) do
                if table.find(selectedItemsESP, name) then enableESP(name, "item")
                else disableESP(name, "item") end
            end
        end
    end
})

Tabs.Main:Toggle({
    ["Title"]    = "Enable Item ESP",
    ["Value"]    = false,
    ["Callback"] = function(state)
        itemESPEnabled = state
        for _, name in ipairs(allItems) do
            if state and table.find(selectedItemsESP, name) then enableESP(name, "item")
            else disableESP(name, "item") end
        end
        if state then
            local items = Workspace:FindFirstChild("Items")
            if items and not itemESPConn then
                itemESPConn = items.ChildAdded:Connect(function(child)
                    if table.find(selectedItemsESP, child.Name) then
                        task.wait(0.1)
                        local part = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart")
                        if part then createESPText(part, child.Name, Color3.fromRGB(0,255,0)) end
                    end
                end)
            end
        elseif itemESPConn then
            itemESPConn:Disconnect(); itemESPConn = nil
        end
    end
})

