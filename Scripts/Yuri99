-- =============================================
-- FUNÇÕES DE AXE
-- =============================================
local function findEquippedAxe(axeOnly)
    for axeName, axeId in pairs(axeIds) do
        if not axeOnly or (axeName == "Old Axe" or axeName == "Good Axe" or axeName == "Strong Axe") then
            local inv = LocalPlayer:FindFirstChild("Inventory")
            if inv then inv = inv:FindFirstChild(axeName) end
            if inv then return inv, axeId end
        end
    end
    return nil, nil
end

local function equipItem(item)
    if item then RemoteEvents.EquipItemHandle:FireServer("FireAllClients", item) end
end

local function unequipItem(item)
    if item then RemoteEvents.UnequipItemHandle:FireServer("FireAllClients", item) end
end

-- =============================================
-- KILL AURA
-- =============================================
local function killAuraLoop()
    while killAuraEnabled do
        local root = GetRoot()
        if root then
            local axe, axeId = findEquippedAxe(false)
            if axe and axeId then
                equipItem(axe)
                for _, entity in ipairs(Workspace.Characters:GetChildren()) do
                    if entity:IsA("Model") then
                        local part = entity:FindFirstChildWhichIsA("BasePart")
                        if part and (part.Position - root.Position).Magnitude <= auraRadius then
                            pcall(function()
                                RemoteEvents.ToolDamageObject:InvokeServer(entity, axe, axeId, CFrame.new(part.Position))
                            end)
                        end
                    end
                end
                task.wait(0.1)
            else
                task.wait(1)
            end
        else
            task.wait(0.5)
        end
    end
end

-- =============================================
-- CHOP AURA
-- =============================================
local function chopAuraLoop()
    while chopAuraEnabled do
        local root = GetRoot()
        if root then
            local axe, axeId = findEquippedAxe(true)
            if axe and axeId then
                equipItem(axe)
                chopCounter = chopCounter + 1
                local mapFolder = Workspace:FindFirstChild("Map")
                if mapFolder then
                    local function processFolder(folder)
                        if not folder then return end
                        for _, item in ipairs(folder:GetChildren()) do
                            if item:IsA("Model") and item.Name == "Small Tree" then
                                local trunk = item:FindFirstChild("Trunk")
                                if trunk and trunk:IsA("BasePart") and (trunk.Position - root.Position).Magnitude <= auraRadius then
                                    task.spawn(function()
                                        while chopAuraEnabled and item and item.Parent do
                                            chopCounter = chopCounter + 1
                                            pcall(function()
                                                RemoteEvents.ToolDamageObject:InvokeServer(item, axe, tostring(chopCounter).."_7367831688", CFrame.new(-2.96,4.55,-75.95,0.896,0,0.443,0,1,0,-0.443,0,0.896))
                                            end)
                                            task.wait(0.5)
                                        end
                                    end)
                                end
                            end
                        end
                    end
                    processFolder(mapFolder:FindFirstChild("Foliage"))
                    processFolder(mapFolder:FindFirstChild("Landmarks"))
                end
                task.wait(0.1)
            else
                task.wait(1)
            end
        else
            task.wait(0.5)
        end
    end
end

-- =============================================
-- ESP
-- =============================================
local espConns = {}

local function createESPText(part, label, color)
    if part:FindFirstChild("YuriESP") then return end
    local bg = Instance.new("BillboardGui")
    bg.Name = "YuriESP"; bg.Adornee = part
    bg.Size = UDim2.new(0,100,0,20); bg.StudsOffset = Vector3.new(0,2.5,0)
    bg.AlwaysOnTop = true; bg.MaxDistance = 300; bg.Parent = part
    local lbl = Instance.new("TextLabel", bg)
    lbl.Size = UDim2.new(1,0,1,0); lbl.BackgroundTransparency = 1
    lbl.Text = label; lbl.TextColor3 = color or Color3.fromRGB(255,255,0)
    lbl.TextStrokeTransparency = 0.2; lbl.TextScaled = true
    lbl.Font = Enum.Font.GothamBold
end

local function enableESP(name, espType)
    local container = espType == "item" and Workspace:FindFirstChild("Items") or Workspace:FindFirstChild("Characters")
    local color = espType == "item" and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,255,0)
    if not container then return end
    for _, child in ipairs(container:GetChildren()) do
        if child.Name == name then
            local part = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart")
            if part then createESPText(part, name, color) end
        end
    end
end

local function disableESP(name, espType)
    local container = espType == "item" and Workspace:FindFirstChild("Items") or Workspace:FindFirstChild("Characters")
    if not container then return end
    for _, child in ipairs(container:GetChildren()) do
        if child.Name == name then
            local part = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart")
            if part then
                for _, gui in ipairs(part:GetChildren()) do
                    if gui:IsA("BillboardGui") and gui.Name == "YuriESP" then gui:Destroy() end
                end
            end
        end
    end
end

-- =============================================
-- BRING ITEMS
-- =============================================
local itemsFolder = Workspace:WaitForChild("Items")

local function matchName(a, b)
    local la, lb = a:lower(), b:lower()
    return la == lb or la == lb.."s" or la.."s" == lb or la:find(lb,1,true) ~= nil
end

local function bringItem(model, targetPos)
    local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart") or model:FindFirstChild("Handle")
    if not part then return end
    if not model.PrimaryPart then pcall(function() model.PrimaryPart = part end) end
    local offset = Vector3.new(math.random(-3,3), math.random(5,10), math.random(-3,3))
    pcall(function()
        RemoteEvents.RequestStartDraggingItem:FireServer(model)
        task.wait(itemDropDelay)
        model:SetPrimaryPartCFrame(CFrame.new(targetPos + offset))
        task.wait(itemDropDelay)
        RemoteEvents.StopDraggingItem:FireServer(model)
    end)
end

local function bringItems(names)
    local root = GetRoot()
    if not root then return 0 end
    local pos = root.Position
    local toProcess = {}
    for _, item in ipairs(itemsFolder:GetChildren()) do
        for _, n in ipairs(names) do
            if matchName(item.Name, n) then table.insert(toProcess, item); break end
        end
    end
    if maxItemsToBring < #toProcess then
        -- shuffle
        for i = #toProcess, 2, -1 do
            local j = math.random(i)
            toProcess[i], toProcess[j] = toProcess[j], toProcess[i]
        end
        toProcess = {table.unpack(toProcess, 1, maxItemsToBring)}
    end
    local count = 0
    coroutine.wrap(function()
        local i = 1
        while i <= #toProcess do
            local batch = 0
            while batch < batchSize and i <= #toProcess do
                local item = toProcess[i]
                task.spawn(function() bringItem(item, pos) end)
                i = i + 1; batch = batch + 1; count = count + 1
            end
            task.wait(batchCooldown)
        end
        Notify("Items Brought", "Successfully brought "..count.." items!", "check")
    end)()
    return count
end

-- =============================================
-- FEED
-- =============================================
local function getHunger()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return 100 end
    local iface = pg:FindFirstChild("Interface")
    if not iface then return 100 end
    local bars = iface:FindFirstChild("StatBars")
    if not bars then return 100 end
    local hb = bars:FindFirstChild("HungerBar")
    if not hb then return 100 end
    local bar = hb:FindFirstChild("Bar")
    return bar and math.floor(bar.Size.X.Scale * 100) or 100
end

local function consumeItem(item)
    pcall(function()
        RemoteEvents.RequestConsumeItem:InvokeServer(item)
        task.wait(feedDelay)
    end)
end

local function feedItems(names)
    if hungerThreshold < getHunger() then
        Notify("Auto Feed", "Hunger above threshold!", "info"); return 0
    end
    local toEat = {}
    for _, item in ipairs(itemsFolder:GetChildren()) do
        for _, n in ipairs(names) do
            if matchName(item.Name, n) then table.insert(toEat, item); break end
        end
    end
    if #toEat == 0 then Notify("Auto Feed", "No food found!", "x"); return 0 end
    if maxFeedItems < #toEat then
        for i = #toEat, 2, -1 do
            local j = math.random(i)
            toEat[i], toEat[j] = toEat[j], toEat[i]
        end
        toEat = {table.unpack(toEat, 1, maxFeedItems)}
    end
    local count = 0
    coroutine.wrap(function()
        local i = 1
        while i <= #toEat do
            local batch = 0
            while batch < feedBatchSize and i <= #toEat do
                local food = toEat[i]
                task.spawn(function() consumeItem(food) end)
                i = i + 1; batch = batch + 1; count = count + 1
            end
            task.wait(feedBatchCooldown)
        end
        Notify("Fed!", "Consumed "..count.." items.", "check")
    end)()
    return count
end

-- =============================================
-- MOVE ITEM TO POSITION (Auto tab)
-- =============================================
local function moveItemToPos(model, targetPos)
    if not (model and model:IsDescendantOf(Workspace)) then return end
    local part = model:IsA("Model") and (model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")) or model
    if not (part and part:IsA("BasePart")) then return end
    if model:IsA("Model") and not model.PrimaryPart then
        pcall(function() model.PrimaryPart = part end)
    end
    pcall(function()
        RemoteEvents.RequestStartDraggingItem:FireServer(model)
        if model:IsA("Model") then
            model:SetPrimaryPartCFrame(CFrame.new(targetPos))
        else
            part.CFrame = CFrame.new(targetPos)
        end
        RemoteEvents.StopDraggingItem:FireServer(model)
    end)
end

