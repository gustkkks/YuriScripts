    ["Title"]    = "Select Entity",
    ["Values"]   = #curMobNames > 0 and curMobNames or {"No entities"},
    ["Value"]    = curMobNames[1] or "No entities",
    ["Callback"] = function(v) selectedMob = v end
})

Tabs.TP:Button({
    ["Title"]    = "Teleport to Entity",
    ["Callback"] = function()
        if not selectedMob then return end
        for i, name in ipairs(curMobNames) do
            if name == selectedMob then
                local mob = curMobs[i]
                if mob then
                    local part = mob.PrimaryPart or mob:FindFirstChildWhichIsA("BasePart")
                    local root = GetRoot()
                    if part and root then root.CFrame = part.CFrame + Vector3.new(0,5,0) end
                end
                break
            end
        end
    end
})

Tabs.TP:Button({
    ["Title"]    = "Refresh Entity List",
    ["Callback"] = function()
        curMobs, curMobNames = getMobs()
        if #curMobNames > 0 then
            selectedMob = curMobNames[1]
            mobDropdown:Refresh(curMobNames, curMobNames[1])
        else
            mobDropdown:Refresh({"No entities"}, "No entities")
        end
    end
})

