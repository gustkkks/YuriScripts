-- =============================================
-- TAB: PREVIEW & AUTO (Planting)
-- =============================================
local previewParts = {}
local previewEnabled = false

local function clearPreview()
    for _, p in ipairs(previewParts) do pcall(function() p:Destroy() end) end
    previewParts = {}
end

local function createPreview()
    clearPreview()
    local count = math.floor(360 / math.deg(plantingAngle))
    local positions = generatePlantingPositions(count)
    for _, pos in ipairs(positions) do
        local part = Instance.new("Part")
        part.Size = Vector3.new(1,1,1)
        part.CFrame = CFrame.new(pos)
        part.Anchored = true; part.CanCollide = false
        part.Transparency = 0.5
        part.BrickColor = BrickColor.new("Bright green")
        part.Material = Enum.Material.Neon
        part.Parent = Workspace
        table.insert(previewParts, part)
    end
end

Tabs.Preview:Section({ ["Title"] = "Visualization", ["Icon"] = "eye" })

Tabs.Preview:Toggle({
    ["Title"]    = "Show Planting Preview",
    ["Value"]    = false,
    ["Callback"] = function(state)
        previewEnabled = state
        if state then createPreview() else clearPreview() end
    end
})

Tabs.Preview:Section({ ["Title"] = "Auto Reposition", ["Icon"] = "refresh-cw" })

Tabs.Preview:Button({
    ["Title"]    = "Auto Reposition Saplings",
    ["Callback"] = function()
        pcall(function()
            local plantRemote = RemoteEvents:WaitForChild("RequestPlantItem")
            local sapling = itemsFolder:WaitForChild("Sapling")
            local count = math.floor(360 / math.deg(plantingAngle))
            local positions = generatePlantingPositions(count)
            task.spawn(function()
                for _, pos in ipairs(positions) do
                    plantRemote:InvokeServer(sapling, pos)
                    task.wait(0.1)
                end
                Notify("Planting","Planted "..#positions.." saplings!","check")
            end)
        end)
    end
})

Tabs.Preview:Paragraph({
    ["Title"] = "How it Works",
    ["Desc"]  = "Plants saplings in Circle or Square patterns around the campfire. Configure radius, angle and height in the Settings tab. Use preview to visualize before planting."
})

