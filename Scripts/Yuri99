local selectedMobsESP = {}
local mobESPEnabled   = false
local mobESPConn      = nil

Tabs.Main:Dropdown({
    ["Title"]    = "Select Entities for ESP",
    ["Values"]   = mobNames,
    ["Value"]    = {},
    ["Multi"]    = true,
    ["Callback"] = function(selected)
        selectedMobsESP = selected
        if mobESPEnabled then
            for _, name in ipairs(mobNames) do
                if table.find(selectedMobsESP, name) then enableESP(name, "mob")
                else disableESP(name, "mob") end
            end
        end
    end
})

Tabs.Main:Toggle({
    ["Title"]    = "Enable Entity ESP",
    ["Value"]    = false,
    ["Callback"] = function(state)
        mobESPEnabled = state
        for _, name in ipairs(mobNames) do
            if state and table.find(selectedMobsESP, name) then enableESP(name, "mob")
            else disableESP(name, "mob") end
        end
        if state then
            local chars = Workspace:FindFirstChild("Characters")
            if chars and not mobESPConn then
                mobESPConn = chars.ChildAdded:Connect(function(child)
                    if table.find(selectedMobsESP, child.Name) then
                        task.wait(0.1)
                        local part = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart")
                        if part then createESPText(part, child.Name, Color3.fromRGB(255,255,0)) end
                    end
                end)
            end
        elseif mobESPConn then
            mobESPConn:Disconnect(); mobESPConn = nil
        end
    end
})

