local selLocations    = {}
local autoTPEnabled   = false
local autoTPThread    = nil

Tabs.TP:Dropdown({
    ["Title"]    = "Select Locations",
    ["Values"]   = {"Campfire","Stronghold","Safe Zone","Trader (Bunny Foot)","Random Tree"},
    ["Value"]    = {},
    ["Multi"]    = true,
    ["Callback"] = function(s) selLocations = s end
})

Tabs.TP:Toggle({
    ["Title"]    = "Auto Teleport Selected",
    ["Value"]    = false,
    ["Callback"] = function(state)
        autoTPEnabled = state
        if state then
            if #selLocations == 0 then Notify("Error","Select locations!","x"); autoTPEnabled=false; return end
            autoTPThread = task.spawn(function()
                while autoTPEnabled do
                    task.wait(1)
                    local loc = selLocations[math.random(1, #selLocations)]
                    local root = GetRoot()
                    if loc == "Campfire" then tp1()
                    elseif loc == "Stronghold" then tp2()
                    elseif loc == "Safe Zone" and root then root.CFrame = CFrame.new(0, 360, 0)
                    elseif loc == "Trader (Bunny Foot)" and root then root.CFrame = CFrame.new(-37.08, 3.98, -16.33)
                    elseif loc == "Random Tree" then tpToRandomTree() end
                    task.wait(teleportDelay)
                end
            end)
        elseif autoTPThread then
            task.cancel(autoTPThread); autoTPThread = nil
        end
    end
})

