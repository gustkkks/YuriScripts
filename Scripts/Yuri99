-- =============================================
-- TAB: SCAN (Map Exploration)
-- =============================================
Tabs.Scan:Section({ ["Title"] = "Map Scan", ["Icon"] = "combine" })
Tabs.Scan:Paragraph({
    ["Title"] = "How it works",
    ["Desc"]  = "Automatically moves your character in a spiral pattern to scan the entire map and track exploration percentage."
})

local scanRunning   = false
local scanAngle     = 0
local scanRadius    = 0
local scanSpeed     = 100
local scanAngleStep = math.rad(10)
local scanRadiusStep= 15
local scanCenter    = Vector3.new(13.287, 100, 0.362)
local scanMaxRadius = 1380
local explorationPct= 0

-- GUI de scan
local scanGui = Instance.new("ScreenGui")
scanGui.Name = "YuriScanGui"; scanGui.ResetOnSpawn = false
scanGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local exploLabel = Instance.new("TextLabel")
exploLabel.Size = UDim2.new(0,250,0,40)
exploLabel.Position = UDim2.new(0.5,-125,0.08,0)
exploLabel.Text = "Exploration: 0%"
exploLabel.BackgroundTransparency = 0.3
exploLabel.TextScaled = true
exploLabel.TextColor3 = Color3.new(1,1,1)
exploLabel.BackgroundColor3 = Color3.new(0,0,0)
exploLabel.BorderSizePixel = 0
exploLabel.Visible = false
exploLabel.Parent = scanGui
Instance.new("UICorner", exploLabel).CornerRadius = UDim.new(0,8)

local progFrame = Instance.new("Frame")
progFrame.Size = UDim2.new(0,250,0,25)
progFrame.Position = UDim2.new(0.5,-125,0.15,0)
progFrame.BackgroundColor3 = Color3.new(0.2,0.2,0.2)
progFrame.BackgroundTransparency = 0.3; progFrame.BorderSizePixel = 0
progFrame.Visible = false; progFrame.Parent = scanGui
Instance.new("UICorner", progFrame).CornerRadius = UDim.new(0,8)

local progBar = Instance.new("Frame")
progBar.Size = UDim2.new(0,0,1,0)
progBar.BackgroundColor3 = Color3.new(0,1,0)
progBar.BorderSizePixel = 0; progBar.Parent = progFrame
Instance.new("UICorner", progBar).CornerRadius = UDim.new(0,8)

local scanBV = Instance.new("BodyVelocity")
scanBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
scanBV.P = 5000; scanBV.Velocity = Vector3.zero

local function scanStep()
    local root = GetRoot()
    if not root then return end
    local target = scanCenter + Vector3.new(
        math.cos(scanAngle) * scanRadius,
        0,
        math.sin(scanAngle) * scanRadius
    )
    local dir = target - root.Position
    if dir.Magnitude < 5 then
        scanAngle = scanAngle + scanAngleStep
        scanRadius = scanRadius + scanRadiusStep * scanAngleStep / (2 * math.pi)
        if scanRadius >= scanMaxRadius then
            scanEnabled = false
            scanBV.Velocity = Vector3.zero
            Notify("Scan", "Map scan complete! 100%", "check")
            exploLabel.Text = "Exploration: 100%"
            progBar.Size = UDim2.new(1,0,1,0)
            return
        end
        local pct = math.floor((scanRadius / scanMaxRadius) * 100)
        explorationPct = pct
        exploLabel.Text = "Exploration: "..pct.."%"
        progBar.Size = UDim2.new(pct/100, 0, 1, 0)
    else
        scanBV.Velocity = dir.Unit * scanSpeed
    end
end

Tabs.Scan:Toggle({
    ["Title"]    = "Enable Map Scan",
    ["Value"]    = false,
    ["Callback"] = function(state)
        scanEnabled = state
        exploLabel.Visible = state; progFrame.Visible = state
        if state then
            local root = GetRoot()
            if root then
                if scanBV.Parent ~= root then scanBV.Parent = root end
                RunService.Heartbeat:Connect(function()
                    if scanEnabled then scanStep() end
                end)
            end
        else
            scanBV.Velocity = Vector3.zero
        end
    end
})

Tabs.Scan:Slider({
    ["Title"]    = "Scan Speed",
    ["Value"]    = { ["Min"]=20, ["Max"]=500, ["Default"]=100 },
    ["Callback"] = function(v) scanSpeed = v end
})

Tabs.Scan:Button({
    ["Title"]    = "Reset Scan",
    ["Callback"] = function()
        scanAngle = 0; scanRadius = 0; explorationPct = 0
        exploLabel.Text = "Exploration: 0%"
        progBar.Size = UDim2.new(0,0,1,0)
        Notify("Scan","Scan reset!","refresh-cw")
    end
})

-- =============================================
-- TAB: VISION (Highlights)
-- =============================================
Tabs.Vision:Section({ ["Title"] = "Highlights", ["Icon"] = "eye" })

local function toggleHighlight(container, state, color)
    if not container then return end
    for _, child in ipairs(container:GetChildren()) do
        local existing = child:FindFirstChild("YuriHL")
        if state then
            if not existing then
                local h = Instance.new("Highlight", child)
                h.Name = "YuriHL"
                h.FillColor = color or Color3.fromRGB(255,255,0)
                h.FillTransparency = 0.5
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            end
        else
            if existing then existing:Destroy() end
        end
    end
end

Tabs.Vision:Toggle({
    ["Title"]    = "Highlight All Items",
    ["Value"]    = false,
    ["Callback"] = function(state)
        toggleHighlight(Workspace:FindFirstChild("Items"), state, Color3.fromRGB(0,255,0))
    end
})

Tabs.Vision:Toggle({
    ["Title"]    = "Highlight All Entities",
    ["Value"]    = false,
    ["Callback"] = function(state)
        toggleHighlight(Workspace:FindFirstChild("Characters"), state, Color3.fromRGB(255,50,50))
    end
})

Tabs.Vision:Toggle({
    ["Title"]    = "Highlight Players",
    ["Value"]    = false,
    ["Callback"] = function(state)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local existing = p.Character:FindFirstChild("YuriPlayerHL")
                if state then
                    if not existing then
                        local h = Instance.new("Highlight", p.Character)
                        h.Name = "YuriPlayerHL"
                        h.FillColor = Color3.fromRGB(0,150,255)
                        h.FillTransparency = 0.5
                        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    end
                else
                    if existing then existing:Destroy() end
                end
            end
        end
    end
})

