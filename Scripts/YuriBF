-- =============================================
-- MATERIAL MON
-- =============================================
function MaterialMon(mat)
    if mat=="Scrap Metal" then
        if Third_Sea then MMon="Reborn Skeleton"; MPos=CFrame.new(-9507,172,6158)
        else MMon="Pirate"; MPos=CFrame.new(-1201.09,40.63,3857.60) end
    elseif mat=="Leather" then
        if First_Sea then MMon="Gorilla"; MPos=CFrame.new(-1142.65,40.46,-515.39)
        elseif Second_Sea then MMon="Zombie"; MPos=CFrame.new(-5150.23,46.30,-755.36)
        else MMon="Forest Pirate"; MPos=CFrame.new(-8543.26,55.54,-7481.16) end
    elseif mat=="Angel Wings"         then MMon="Dark Master";           MPos=CFrame.new(-5148.17,439.05,-2332.96)
    elseif mat=="Magma Ore"           then MMon="Magma Ninja";           MPos=CFrame.new(-4262.94,110.89,5101.63)
    elseif mat=="Fish Tail"           then MMon="Fishman Raider";        MPos=CFrame.new(-3095.49,160.00,3664.97)
    elseif mat=="Radioactive Material"then MMon="Lab Subordinate";       MPos=CFrame.new(-4262.94,110.89,5101.63)
    elseif mat=="Mystic Droplet"      then MMon="Sea Soldier";           MPos=CFrame.new(3553.16,8.32,3886.35)
    elseif mat=="Vampire Fang"        then MMon="Vampire";               MPos=CFrame.new(-6033,7,-1317)
    elseif mat=="Demonic Wisp"        then MMon="Demonic Soul";          MPos=CFrame.new(-9507,172,6158)
    elseif mat=="Conjured Cocoa"      then MMon="Chocolate Bar Battler"; MPos=CFrame.new(620.63,78.94,-12581.37)
    elseif mat=="Dragon Scale"        then MMon="Dragon Crew Archer";    MPos=CFrame.new(6594,383,139)
    elseif mat=="Gunpowder"           then MMon="Pistol Billionaire";    MPos=CFrame.new(-469,74,5904)
    elseif mat=="Mini Tusk"           then MMon="Mythological Pirate";   MPos=CFrame.new(-13545,470,-6917)
    end
end

-- =============================================
-- AUTO FARM LOOP
-- =============================================
_G.AutoFarm = false

spawn(function()
    while true do
        wait(0.1)
        if _G.AutoFarm then
            pcall(function()
                CheckLevel()
                local hasQuest = LocalPlayer.PlayerGui.Main.Quest.Visible
                if not hasQuest and CFrameQ then
                    if BypassTP then BTP(CFrameQ) else Tween(CFrameQ) end
                    wait(0.5)
                    Remotes.CommF_:InvokeServer("StartQuest", NameQuest, QuestLv)
                    wait(0.3)
                end
                if CFrameMon then
                    if BypassTP then BTP(CFrameMon) else Tween(CFrameMon) end
                end
                if workspace.Enemies:FindFirstChild(Ms or "") then
                    for _, mob in pairs(workspace.Enemies:GetChildren()) do
                        if mob.Name==(Ms or "") and mob:FindFirstChild("Humanoid") and mob:FindFirstChild("HumanoidRootPart") and mob.Humanoid.Health>0 then
                            AutoHaki(); EquipTool(SelectWeapon)
                            Tween(mob.HumanoidRootPart.CFrame * Pos)
                            mob.HumanoidRootPart.Size = Vector3.new(1,1,1)
                            mob.HumanoidRootPart.Transparency = 1
                            mob.Humanoid.JumpPower = 0; mob.Humanoid.WalkSpeed = 0
                            mob.HumanoidRootPart.CanCollide = false
                            Click(); FarmPos=mob.HumanoidRootPart.CFrame; MonFarm=mob.Name
                        end
                    end
                end
            end)
        end
    end
end)

-- BRING MOBS
spawn(function()
    while task.wait() do
        if BringMobs and MonFarm and FarmPos then
            pcall(function()
                for _, mob in pairs(workspace.Enemies:GetChildren()) do
                    if mob.Name==MonFarm and mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health>0 and InMyNetWork(mob.HumanoidRootPart) then
                        mob.HumanoidRootPart.CFrame = FarmPos
                        mob.HumanoidRootPart.CanCollide = false
                        mob.HumanoidRootPart.Size = Vector3.new(1,1,1)
                    end
                end
            end)
        end
    end
end)

-- NOCLIP AUTO
spawn(function()
    RunService.Stepped:Connect(function()
        if _G.AutoFarm or _G.Clip2 then
            pcall(function()
                local char = GetChar()
                if char then
                    for _, p in pairs(char:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                end
            end)
        end
    end)
end)

-- SIMULATION RADIUS
spawn(function()
    while true do
        wait()
        pcall(function()
            if setscriptable then setscriptable(LocalPlayer,"SimulationRadius",true) end
            if sethiddenproperty then sethiddenproperty(LocalPlayer,"SimulationRadius",math.huge) end
        end)
    end
end)

-- FAST ATTACK HOOK
local cfParticle, cfRigLib = nil, nil
pcall(function()
    cfParticle = require(LocalPlayer.PlayerScripts.CombatFramework.Particle)
    cfRigLib   = require(ReplicatedStorage.CombatFramework.RigLib)
end)
spawn(function()
    while task.wait() do
        pcall(function()
            if not shared.orl then shared.orl = cfRigLib.wrapAttackAnimationAsync end
            if not shared.cpc then shared.cpc = cfParticle.play end
            cfRigLib.wrapAttackAnimationAsync = function(anim, a, b, c, callback)
                local hits = cfRigLib.getBladeHits(a,b,c)
                if hits then
                    if FastAttack then
                        cfParticle.play = function() end
                        anim:Play(0.01,0.01,0.01)
                        callback(hits)
                        cfParticle.play = shared.cpc
                        wait(anim.length*0.5)
                        anim:Stop()
                    else anim:Play() end
                end
            end
        end)
    end
end)

-- SKILL AIMBOT HOOK
spawn(function()
    pcall(function()
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(...)
            local method = getnamecallmethod()
            local args = {...}
            if tostring(method)=="FireServer" and tostring(args[1])=="RemoteEvent" and tostring(args[2])~="true" and tostring(args[2])~="false" then
                if Skillaimbot and AimBotSkillPosition then
                    args[2] = AimBotSkillPosition
                    return old(unpack(args))
                end
            end
            return old(...)
        end)
    end)
end)

-- AUTO HAKI
spawn(function() while task.wait(1) do pcall(function() if _G.AutoFarm then AutoHaki() end end) end end)

-- KILL AURA
spawn(function()
    while task.wait() do
        if KillAura then
            pcall(function()
                for _, mob in pairs(workspace.Enemies:GetDescendants()) do
                    if mob:FindFirstChild("Humanoid") and mob:FindFirstChild("HumanoidRootPart")
                        and (mob.HumanoidRootPart.Position - (GetRoot() and GetRoot().Position or Vector3.new())).Magnitude < 1500
                        and mob.Humanoid.Health > 0
                    then
                        mob.Humanoid.Health = 0
                        pcall(function() sethiddenproperty(LocalPlayer,"SimulationRadius",math.huge) end)
                    end
                end
            end)
        end
    end
end)

