Tabs.Dojo:Toggle({ ["Title"]="Auto Dragon Hunter (Blaze Ember)", ["Value"]=false, ["Callback"]=function(state)
    _G.AutoDragonHunter=state
    if state then
        spawn(function()
            while _G.AutoDragonHunter do
                pcall(function()
                    for _, mob in pairs(workspace.Enemies:GetChildren()) do
                        if (mob.Name=="Dragon" or mob.Name=="Elder Dragon") and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health>0 then
                            AutoHaki(); EquipTool(SelectWeapon)
                            Tween(mob.HumanoidRootPart.CFrame * Pos)
                            mob.HumanoidRootPart.CanCollide=false
                            Click()
                        end
                    end
                end)
                task.wait(0.5)
            end
        end)
    end
end })

