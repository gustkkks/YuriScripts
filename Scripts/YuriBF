-- RACE V4 AUTO TRIALS (Night Slayer)
-- =============================================
local raceV4Positions = {
    ["Human"]   = { trial=CFrame.new(-1463.57,66.37,-2247.90), start=CFrame.new(-1474.99,66.37,-2247.90) },
    ["Mink"]    = { trial=CFrame.new(-2617.88,798.49,-2110.30),start=CFrame.new(-2633.53,798.49,-2096.94) },
    ["Fishman"] = { trial=CFrame.new(-4631.73,71.97,-1265.00), start=CFrame.new(-4648.54,71.97,-1265.67) },
    ["Skypiean"]= { trial=CFrame.new(-5157.27,815.40,-2246.64),start=CFrame.new(-5145.67,815.40,-2261.38) },
    ["Ghoul"]   = { trial=CFrame.new(-5004.36,38.64,-749.54),  start=CFrame.new(-4990.24,38.64,-754.42) },
    ["Cyborg"]  = { trial=CFrame.new(533.23,204.04,-3339.94),  start=CFrame.new(550.84,204.04,-3339.94) },
}

spawn(function()
    while task.wait(0.5) do
        if _G.AutoRaceV4 and _G.SelectRaceV4 then
            pcall(function()
                local pos = raceV4Positions[_G.SelectRaceV4]
                if not pos then return end
                local root = GetRoot()
                if root then root.CFrame = pos.start end
                wait(0.5)
                Remotes.CommF_:InvokeServer("StartRaceTrial", _G.SelectRaceV4)
                wait(1)
                -- Auto kill player during trial if enabled
                if _G.KillAfterTrial then
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") then
                            pcall(function() p.Character.Humanoid.Health = 0 end)
                        end
                    end
                end
                local trialComplete = false
                local timeout = 0
                while not trialComplete and timeout < 30 do
                    wait(1); timeout = timeout + 1
                    pcall(function()
                        if LocalPlayer:FindFirstChild("RaceV4") then trialComplete = true end
                    end)
                end
            end)
        end
    end
end)

