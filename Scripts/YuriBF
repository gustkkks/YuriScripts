Tabs.Misc:Button({ ["Title"]="Server Hop",   ["Callback"]=function()
    pcall(function()
        local bM={}; local bO=20
        for page=1,100 do
            for id, data in pairs(ReplicatedStorage.__ServerBrowser and ReplicatedStorage.__ServerBrowser:InvokeServer(page) or {}) do
                if id~=game.JobId and data.Count<bO then
                    if not bM[id] or 600<tick()-bM[id].Time then
                        bM[id]={Time=tick()}
                        ReplicatedStorage.__ServerBrowser:InvokeServer("teleport",id)
                        return
                    end
                end
            end
        end
        SendNotif("Server Hop","No server found!",3)
    end)
end })
