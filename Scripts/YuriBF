-- =============================================
-- ESP FUNCTIONS
-- =============================================
function updatePlayerESP()
    for _, p in pairs(Players:GetChildren()) do
        pcall(function()
            if p.Character then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    if ESPPlayer then
                        local existing = head:FindFirstChild("NameEsp"..Number)
                        if not existing then
                            local bg = Instance.new("BillboardGui",head)
                            bg.Name="NameEsp"..Number; bg.ExtentsOffset=Vector3.new(0,1,0)
                            bg.Size=UDim2.new(1,200,1,30); bg.Adornee=head; bg.AlwaysOnTop=true
                            local lbl = Instance.new("TextLabel",bg)
                            lbl.Font=Enum.Font.GothamSemibold; lbl.FontSize="Size14"; lbl.TextWrapped=true
                            lbl.Size=UDim2.new(1,0,1,0); lbl.TextYAlignment="Top"
                            lbl.BackgroundTransparency=1; lbl.TextStrokeTransparency=0.5
                            local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
                            local dist = myHead and round((head.Position-myHead.Position).Magnitude/3) or 0
                            lbl.Text = p.Name.." | "..dist.." dist"
                            lbl.TextColor3 = (p.Team==LocalPlayer.Team) and Color3.new(0,1,0) or Color3.new(1,0,0)
                        else
                            local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
                            local dist = myHead and round((head.Position-myHead.Position).Magnitude/3) or 0
                            local hp = p.Character.Humanoid and round(p.Character.Humanoid.Health*100/p.Character.Humanoid.MaxHealth) or 0
                            existing.TextLabel.Text = p.Name.." | "..dist.." dist | "..hp.."%"
                        end
                    else
                        local ex = head:FindFirstChild("NameEsp"..Number)
                        if ex then ex:Destroy() end
                    end
                end
            end
        end)
    end
end

function updateFruitESP()
    for _, obj in pairs(workspace:GetChildren()) do
        pcall(function()
            if string.find(obj.Name,"Fruit") and obj:FindFirstChild("Handle") then
                local handle = obj.Handle
                if DevilFruitESP then
                    if not handle:FindFirstChild("NameEsp"..Number) then
                        local bg = Instance.new("BillboardGui",handle)
                        bg.Name="NameEsp"..Number; bg.ExtentsOffset=Vector3.new(0,1,0)
                        bg.Size=UDim2.new(1,200,1,30); bg.Adornee=handle; bg.AlwaysOnTop=true
                        local lbl = Instance.new("TextLabel",bg)
                        lbl.Font=Enum.Font.GothamSemibold; lbl.FontSize="Size14"; lbl.TextWrapped=true
                        lbl.Size=UDim2.new(1,0,1,0); lbl.TextYAlignment="Top"
                        lbl.BackgroundTransparency=1; lbl.TextStrokeTransparency=0.5
                        lbl.TextColor3=Color3.fromRGB(255,255,255)
                        local myHead=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
                        local dist=myHead and round((handle.Position-myHead.Position).Magnitude/3) or 0
                        lbl.Text=obj.Name.." | "..dist.." dist"
                    end
                else
                    local ex = handle:FindFirstChild("NameEsp"..Number)
                    if ex then ex:Destroy() end
                end
            end
        end)
    end
end

function updateIslandESP()
    pcall(function()
        for _, loc in pairs(workspace._WorldOrigin.Locations:GetChildren()) do
            pcall(function()
                if IslandESP and loc.Name~="Sea" then
                    if not loc:FindFirstChild("NameEsp") then
                        local bg=Instance.new("BillboardGui",loc); bg.Name="NameEsp"
                        bg.ExtentsOffset=Vector3.new(0,1,0); bg.Size=UDim2.new(1,200,1,30)
                        bg.Adornee=loc; bg.AlwaysOnTop=true
                        local lbl=Instance.new("TextLabel",bg)
                        lbl.Font="GothamBold"; lbl.FontSize="Size14"; lbl.TextWrapped=true
                        lbl.Size=UDim2.new(1,0,1,0); lbl.TextYAlignment="Top"
                        lbl.BackgroundTransparency=1; lbl.TextStrokeTransparency=0.5
                        lbl.TextColor3=Color3.fromRGB(7,236,240)
                    else
                        local myHead=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
                        local dist=myHead and round((loc.Position-myHead.Position).Magnitude/3) or 0
                        loc.NameEsp.TextLabel.Text=loc.Name.." | "..dist.." dist"
                    end
                elseif loc:FindFirstChild("NameEsp") then loc:FindFirstChild("NameEsp"):Destroy() end
            end)
        end
    end)
end

function updateFlower()
    for _, obj in pairs(workspace:GetChildren()) do
        pcall(function()
            if obj.Name=="Flower1" or obj.Name=="Flower2" then
                if FlowerESP then
                    if not obj:FindFirstChild("NameEsp"..Number) then
                        local bg=Instance.new("BillboardGui",obj); bg.Name="NameEsp"..Number
                        bg.ExtentsOffset=Vector3.new(0,1,0); bg.Size=UDim2.new(1,200,1,30)
                        bg.Adornee=obj; bg.AlwaysOnTop=true
                        local lbl=Instance.new("TextLabel",bg)
                        lbl.Font=Enum.Font.GothamSemibold; lbl.FontSize="Size14"; lbl.TextWrapped=true
                        lbl.Size=UDim2.new(1,0,1,0); lbl.TextYAlignment="Top"
                        lbl.BackgroundTransparency=1; lbl.TextStrokeTransparency=0.5
                        local myHead=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
                        local dist=myHead and round((obj.Position-myHead.Position).Magnitude/3) or 0
                        if obj.Name=="Flower1" then lbl.TextColor3=Color3.fromRGB(0,0,255); lbl.Text="Blue Flower | "..dist.." dist"
                        else lbl.TextColor3=Color3.fromRGB(255,0,0); lbl.Text="Red Flower | "..dist.." dist" end
                    end
                else
                    local ex=obj:FindFirstChild("NameEsp"..Number)
                    if ex then ex:Destroy() end
                end
            end
        end)
    end
end

function updateChestESP()
    for _, obj in pairs(workspace:GetChildren()) do
        pcall(function()
            if string.find(obj.Name,"Chest") then
                local ex=obj:FindFirstChild("NameEsp"..Number)
                if ChestESP then
                    if not ex then
                        local bg=Instance.new("BillboardGui",obj); bg.Name="NameEsp"..Number
                        bg.ExtentsOffset=Vector3.new(0,1,0); bg.Size=UDim2.new(1,200,1,30)
                        bg.Adornee=obj; bg.AlwaysOnTop=true
                        local lbl=Instance.new("TextLabel",bg)
                        lbl.Font=Enum.Font.GothamSemibold; lbl.FontSize="Size14"; lbl.TextWrapped=true
                        lbl.Size=UDim2.new(1,0,1,0); lbl.TextYAlignment="Top"
                        lbl.BackgroundTransparency=1; lbl.TextStrokeTransparency=0.5
                        local myHead=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
                        local dist=myHead and round((obj.Position-myHead.Position).Magnitude/3) or 0
                        if obj.Name=="Chest1" then lbl.TextColor3=Color3.fromRGB(109,109,109)
                        elseif obj.Name=="Chest2" then lbl.TextColor3=Color3.fromRGB(173,158,21)
                        elseif obj.Name=="Chest3" then lbl.TextColor3=Color3.fromRGB(85,255,255) end
                        lbl.Text=obj.Name.." | "..dist.." dist"
                    end
                else if ex then ex:Destroy() end end
            end
        end)
    end
end

-- ESP LOOPS
spawn(function() while wait(2) do if FlowerESP then pcall(updateFlower) end end end)
spawn(function() while wait(2) do if DevilFruitESP then pcall(updateFruitESP) end end end)
spawn(function() while wait(2) do if ChestESP then pcall(updateChestESP) end end end)
spawn(function() while wait(2) do if ESPPlayer then pcall(updatePlayerESP) end end end)
spawn(function() while wait(1) do if IslandESP then pcall(updateIslandESP) end end end)

-- FPS FUNCTIONS
function FpsBoost()
    pcall(function()
        workspace.Terrain.WaterWaveSize=0; workspace.Terrain.WaterWaveSpeed=0
        workspace.Terrain.WaterReflectance=0; workspace.Terrain.WaterTransparency=0
        Lighting.GlobalShadows=false; Lighting.FogEnd=9e9; Lighting.Brightness=0
        settings().Rendering.QualityLevel="Level01"
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Trail") then v.Lifetime=NumberRange.new(0)
            elseif v:IsA("Explosion") then v.BlastPressure=1; v.BlastRadius=1
            elseif v:IsA("Fire") or v:IsA("SpotLight") or v:IsA("Smoke") or v:IsA("Sparkles") then v.Enabled=false
            elseif v:IsA("Part") or v:IsA("Union") or v:IsA("MeshPart") or v:IsA("CornerWedgePart") then v.Material=Enum.Material.Plastic; v.Reflectance=0
            elseif v:IsA("Decal") or v:IsA("Texture") then v.Transparency=1 end
        end
        for _, v in pairs(Lighting:GetChildren()) do
            if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") then v.Enabled=false end
        end
    end)
end

-- ANTI AFK
LocalPlayer.Idled:Connect(function()
    VirtualUser:Button2Down(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
    wait(1)
    VirtualUser:Button2Up(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
end)

-- AUTO REJOIN
pcall(function()
    game:GetService("CoreGui").RobloxPromptGui.promptOverlay.ChildAdded:Connect(function(obj)
        if obj.Name=="ErrorPrompt" then
            if obj.Visible and obj.TitleFrame.ErrorTitle.Text~="Teleport Failed" then
                TeleportService:TeleportToPlaceInstance(game.PlaceId,game.JobId,LocalPlayer)
            end
            obj:GetPropertyChangedSignal("Visible"):Connect(function()
                if obj.Visible and obj.TitleFrame.ErrorTitle.Text~="Teleport Failed" then
                    TeleportService:TeleportToPlaceInstance(game.PlaceId,game.JobId,LocalPlayer)
                end
            end)
        end
    end)
end)

