Tabs.Main:Toggle({
    ["Title"]="Auto Boss Farm", ["Value"]=false,
    ["Callback"]=function(state)
        _G.AutoBoss=state
        if state then
            spawn(function()
                while _G.AutoBoss do
                    pcall(function()
                        CheckBossQuest()
                        if not LocalPlayer.PlayerGui.Main.Quest.Visible and CFrameQBoss then
                            if BypassTP then BTP(CFrameQBoss) else Tween(CFrameQBoss) end
                            wait(0.5)
                            if NameQuestBoss then Remotes.CommF_:InvokeServer("StartQuest",NameQuestBoss,QuestLvBoss) end
                        end
                        if CFrameBoss then if BypassTP then BTP(CFrameBoss) else Tween(CFrameBoss) end end
                        if BossMon and workspace.Enemies:FindFirstChild(BossMon) then
                            for _, mob in pairs(workspace.Enemies:GetChildren()) do
                                if mob.Name==BossMon and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health>0 then
                                    AutoHaki(); EquipTool(SelectWeapon)
                                    Tween(mob.HumanoidRootPart.CFrame * Pos)
                                    mob.HumanoidRootPart.Size=Vector3.new(120,120,120)
                                    mob.HumanoidRootPart.CanCollide=false
                                    Click(); FarmPos=mob.HumanoidRootPart.CFrame; MonFarm=mob.Name
                                end
                            end
                        end
                    end)
                    wait(0.1)
                end
            end)
        end
    end
})

