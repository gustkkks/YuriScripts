-- =============================================
-- AUTO TEAM SELECT
-- =============================================
task.spawn(function()
    pcall(function()
        local main = game.Players.LocalPlayer.PlayerGui:WaitForChild("Main", 10)
        if not main then return end
        local ct = main:FindFirstChild("ChooseTeam")
        if not ct then return end
        local timeout = 0
        while ct.Visible == false and timeout < 30 do task.wait(0.1); timeout = timeout + 0.1 end
        local container = ct:WaitForChild("Container", 5)
        if not container then return end
        if _G.Team == "Marine" then
            pcall(function() for _, c in pairs(getconnections(container.Marines.Frame.TextButton.Activated)) do c.Function() end end)
        else
            pcall(function() for _, c in pairs(getconnections(container.Pirates.Frame.TextButton.Activated)) do c.Function() end end)
        end
    end)
end)

