local function AutoHaki()
    pcall(function()
        local char = GetChar()
        if char and char:FindFirstChild("HasBuso") and not char.HasBuso.Value then
            Remotes.CommF_:InvokeServer("Haki","Buso")
        end
    end)
end

local function EquipTool(name)
    if not name then return end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        local tool = bp:FindFirstChild(name)
        if tool then wait(0.1); local hum=GetHum(); if hum then hum:EquipTool(tool) end end
    end
end

local function Click()
    if not FastAttack then
        pcall(function()
            local fw = debug.getupvalues(require(LocalPlayer.PlayerScripts.CombatFramework))[2]
            require(ReplicatedStorage.Util.CameraShaker):Stop()
            fw.activeController.attacking = false
            fw.activeController.timeToNextAttack = 0
            fw.activeController.hitboxMagnitude = 180
        end)
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(1280,672))
    end
end

local function InMyNetWork(part)
    if isnetworkowner then return isnetworkowner(part) end
    local root = GetRoot()
    if root and (part.Position-root.Position).Magnitude<=350 then return true end
    return false
end

local function BTP(cf) pcall(function() local r=GetRoot(); if r then r.CFrame=cf end end) end

