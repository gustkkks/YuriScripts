local function SendNotif(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", { Title = title, Text = text, Duration = duration or 4 })
    end)
end

local function GetChar()  return LocalPlayer.Character end
local function GetRoot()  local c = GetChar(); return c and c:FindFirstChild("HumanoidRootPart") end
local function GetHum()   local c = GetChar(); return c and c:FindFirstChildOfClass("Humanoid") end
local Number = math.random(1,1000000)
local function round(n) return math.floor(tonumber(n) + 0.5) end

local function TeleportTo(cf)
    local char = GetChar()
    if char and char.PrimaryPart then char:SetPrimaryPartCFrame(cf) end
end

local function Tween(cf)
    local root = GetRoot()
    if not root or not cf then return end
    local dist = (cf.Position - root.Position).Magnitude
    if dist <= 150 then root.CFrame = cf; return end
    local tw = TweenService:Create(root, TweenInfo.new(dist/300, Enum.EasingStyle.Linear), { CFrame = cf })
    tw:Play(); wait(dist/300)
end

local function TP2(cf)
    local root = GetRoot()
    if not root or not cf then return end
    local dist = (cf.Position - root.Position).Magnitude
    local spd  = dist >= 1 and 150 or Speed
    local tw   = TweenService:Create(root, TweenInfo.new(dist/spd, Enum.EasingStyle.Linear), { CFrame = cf })
    tw:Play(); _G.Clip2 = true; wait(dist/spd); _G.Clip2 = false
end

