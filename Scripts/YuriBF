Tabs.Combat:Section({ ["Title"]="Player Targeting", ["Icon"]="user" })
local selCombatPly = nil
Tabs.Combat:Input({ ["Title"]="Target Player Name", ["Placeholder"]="Enter name...", ["Callback"]=function(text)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(text:lower(),1,true) or p.DisplayName:lower():find(text:lower(),1,true) then
            selCombatPly=p; SendNotif("Target","Set: "..p.DisplayName,3); return
        end
    end
    SendNotif("Not Found",text,3)
end })
Tabs.Combat:Button({ ["Title"]="TP to Player", ["Callback"]=function()
    if not selCombatPly then SendNotif("Error","Select a player!",2); return end
    local root=GetRoot(); local tr=selCombatPly.Character and selCombatPly.Character:FindFirstChild("HumanoidRootPart")
    if root and tr then root.CFrame=tr.CFrame*CFrame.new(0,0,3) end
end })
Tabs.Combat:Button({ ["Title"]="Spectate Player", ["Callback"]=function()
    if not selCombatPly then SendNotif("Error","Select a player!",2); return end
    local hum=selCombatPly.Character and selCombatPly.Character:FindFirstChildOfClass("Humanoid")
    if hum then workspace.CurrentCamera.CameraSubject=hum; SendNotif("Spectating",selCombatPly.DisplayName,3) end
end })
Tabs.Combat:Button({ ["Title"]="Stop Spectating", ["Callback"]=function() local h=GetHum(); if h then workspace.CurrentCamera.CameraSubject=h end end })

