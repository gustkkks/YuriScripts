-- =============================================
-- AIMBOT (Night Slayer)
-- =============================================
local AimbotConn = nil

spawn(function()
    while task.wait() do
        if _G.AutoAimbot then
            local nearest = nil
            local nearDist = math.huge
            local cam = workspace.CurrentCamera
            local vp = cam.ViewportSize
            local center = Vector2.new(vp.X/2, vp.Y/2)
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local screen, onScreen = cam:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
                    if onScreen then
                        local dist = (Vector2.new(screen.X,screen.Y)-center).Magnitude
                        if dist < nearDist then nearest=p; nearDist=dist end
                    end
                end
            end
            if nearest and nearest.Character then
                local head = nearest.Character:FindFirstChild("Head")
                if head then
                    AimBotSkillPosition = head.Position
                    if _G.AimbotCamera then
                        cam.CFrame = CFrame.lookAt(cam.CFrame.Position, head.Position)
                    end
                end
            end
        else
            AimBotSkillPosition = nil
        end
    end
end)

