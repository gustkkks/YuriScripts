                    Remotes.CommF_:InvokeServer("AddPoint", stat, 3)
                end
            end)
        end
    end
end)

-- AUTO MATERIAL FARM
spawn(function()
    while task.wait() do
        if AutoFarmMaterial and SelectMaterial then
            pcall(function()
                MaterialMon(SelectMaterial)
                if BypassTP then BTP(MPos) else Tween(MPos) end
                if workspace.Enemies:FindFirstChild(MMon or "") then
                    for _, mob in pairs(workspace.Enemies:GetChildren()) do
                        if mob.Name==(MMon or "") and mob:FindFirstChild("Humanoid") and mob:FindFirstChild("HumanoidRootPart") and mob.Humanoid.Health>0 then
                            while AutoFarmMaterial do
                                task.wait()
                                AutoHaki(); EquipTool(SelectWeapon)
                                Tween(mob.HumanoidRootPart.CFrame * Pos)
                                mob.HumanoidRootPart.Size = Vector3.new(60,60,60)
                                mob.HumanoidRootPart.Transparency = 1
                                mob.Humanoid.JumpPower = 0; mob.Humanoid.WalkSpeed = 0
                                mob.HumanoidRootPart.CanCollide = false
                                FarmPos=mob.HumanoidRootPart.CFrame; MonFarm=mob.Name
                                Click()
                                if not AutoFarmMaterial or not mob.Parent or mob.Humanoid.Health<=0 then break end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

