-- AUTO LAW
spawn(function()
    pcall(function()
        while wait() do
            if Auto_Law then
                local char = GetChar(); local bp = LocalPlayer:FindFirstChild("Backpack")
                if not (char and char:FindFirstChild("Microchip")) and not (bp and bp:FindFirstChild("Microchip")) then
                    if not workspace.Enemies:FindFirstChild("Order") then
                        wait(1)
                        Remotes.CommF_:InvokeServer("BlackbeardReward","Microchip","1")
                        Remotes.CommF_:InvokeServer("BlackbeardReward","Microchip","2")
                    end
                end
                if (char and char:FindFirstChild("Microchip")) or (bp and bp:FindFirstChild("Microchip")) then
                    pcall(function() fireclickdetector(workspace.Map.CircleIsland.RaidSummon.Button.Main.ClickDetector) end)
                end
                if workspace.Enemies:FindFirstChild("Order") then
                    for _, mob in pairs(workspace.Enemies:GetChildren()) do
                        if mob.Name=="Order" and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health>0 then
                            while Auto_Law do
                                RunService.Heartbeat:wait()
                                AutoHaki(); EquipTool(SelectWeapon)
                                Tween(mob.HumanoidRootPart.CFrame * Pos)
                                mob.HumanoidRootPart.CanCollide=false
                                mob.HumanoidRootPart.Size=Vector3.new(120,120,120)
                                Click(); FarmPos=mob.HumanoidRootPart.CFrame; MonFarm=mob.Name
                                if not Auto_Law or not mob.Parent or mob.Humanoid.Health<=0 then break end
                            end
                        end
                    end
                end
            end
        end
    end)
end)

