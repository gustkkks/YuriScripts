-- ============ CHARACTER RESPAWN ============
LocalPlayer.CharacterAdded:Connect(function(char)
    safeCall(function()
        task.wait(0.5)
        pcall(function()
            local hum = char:WaitForChild("Humanoid")
            hum.WalkSpeed = Settings.WalkSpeed
            hum.JumpPower = Settings.JumpPower
            log("INFO", "Configuracoes de personagem aplicadas no respawn.", "CharacterRespawn")
        end)
    end, "CharacterAdded_Respawn")
end)
