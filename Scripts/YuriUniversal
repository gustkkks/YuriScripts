-- =============================================
task.wait(0.5)
SendNotif("YuriScripts Universal", "V1.1 Loaded! Toggle: RightCtrl | by Yuri Dev", 5)
print("✅ YuriScripts Universal V1.1 loaded!")
print("👤 Made By Yuri Dev")
