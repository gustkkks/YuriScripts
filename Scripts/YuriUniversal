-- Universal Script
-- Version 1.0.8
-- Fix: Drawing API Compatibility & Visibility

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local Teams = game:GetService("Teams")

-- ============ DEBUG LOGGER ============
local function log(level, message, funcName)
    local prefix = "[YuriUniversal]"
    local output = string.format("%s [%s] %s%s", prefix, level, (funcName and funcName .. ": " or ""), message)
    if level == "ERROR" or level == "WARN" then warn(output) else print(output) end
end

local function safeCall(func, funcName, ...)
    local success, result = xpcall(func, function(err) return err .. "\n" .. debug.traceback() end, ...)
    if not success then
        log("ERROR", result, funcName)
        return false, result
    end
    return true, result
end

-- ============ SETTINGS ============
local Settings = {
    WalkSpeed = 16,
    JumpPower = 50,
    SpeedEnabled = false,
    JumpEnabled = false,
    AimbotEnabled = false,
    Smoothness = 0.5,
    FOV = 150,
    ShowFOV = true,
    FOVColor = Color3.fromRGB(255, 255, 255),
    TeamCheck = true,
    WallCheck = true,
    ESPEnabled = false,
    ESPBox = true,
    ESPLine = true,
    ESPName = true,
    ESPDistance = true,
    ESPTeamColor = false,
    ESPColor = Color3.fromRGB(255, 255, 255),
    InstantInteract = false,
    WhitelistedTeams = {},
}

-- ============ WALKSPEED / JUMP ============
local function ApplyCharacter(char)
    safeCall(function()
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            hum.WalkSpeed = Settings.WalkSpeed
            hum.JumpPower = Settings.JumpPower
        end
    end, "ApplyCharacter")
end

LocalPlayer.CharacterAdded:Connect(ApplyCharacter)
if LocalPlayer.Character then ApplyCharacter(LocalPlayer.Character) end

task.spawn(function()
    while task.wait(0.5) do
        safeCall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
                local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if Settings.SpeedEnabled then hum.WalkSpeed = Settings.WalkSpeed end
                if Settings.JumpEnabled then hum.JumpPower = Settings.JumpPower end
            end
        end, "StatLoop")
    end
end)

-- ============ WALL CHECK ============
local function IsVisible(targetPart, targetCharacter)
    if not Settings.WallCheck then return true end
    local origin = Camera.CFrame.Position
    local dest = targetPart.Position
    local direction = (dest - origin).Unit
    local distance = (dest - origin).Magnitude

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, targetCharacter, Camera}
    raycastParams.IgnoreWater = true

    local result = Workspace:Raycast(origin, direction * distance, raycastParams)
    return result == nil
end

-- ============ TARGETING ============
local function GetClosestTarget()
    local closest = nil
    local closestDist = Settings.FOV
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if Settings.TeamCheck and player.Team == LocalPlayer.Team then continue end
        if table.find(Settings.WhitelistedTeams, player.Team and player.Team.Name) then continue end
        
        local char = player.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
        if not onScreen then continue end

        local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist2D < closestDist then
            if IsVisible(root, char) then
                closestDist = dist2D
                closest = player
            end
        end
    end
    return closest
end

-- ============ DRAWING UTILS ============
local function createDrawing(type, props)
    local obj = Drawing.new(type)
    for k, v in pairs(props) do obj[k] = v end
    return obj
end

-- ============ FOV ============
local FOVCircle = createDrawing("Circle", {
    Thickness = 1.5,
    NumSides = 64,
    Filled = false,
    Transparency = 0.7,
    Visible = false
})

-- ============ ESP SYSTEM ============
local ESP = {}
local function createESP(player)
    if ESP[player] then return end
    ESP[player] = {
        Box = createDrawing("Square", { Thickness = 1.5, Filled = false, Transparency = 0.8, Visible = false }),
        Line = createDrawing("Line", { Thickness = 1.5, Transparency = 0.8, Visible = false }),
        Name = createDrawing("Text", { Size = 14, Center = true, Outline = true, Visible = false }),
        Dist = createDrawing("Text", { Size = 12, Center = true, Outline = true, Visible = false })
    }
end

local function removeESP(player)
    if ESP[player] then
        for _, obj in pairs(ESP[player]) do obj:Remove() end
        ESP[player] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then createESP(p) end end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

-- ============ MAIN RENDER LOOP ============
RunService.RenderStepped:Connect(function()
    -- FOV Update
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Radius = Settings.FOV
    FOVCircle.Color = Settings.FOVColor
    FOVCircle.Visible = Settings.ShowFOV

    -- Aimbot Logic
    if Settings.AimbotEnabled then
        local target = GetClosestTarget()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local root = target.Character.HumanoidRootPart
            local targetPos = root.Position
            if Settings.Smoothness > 0 then
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, targetPos), 1 - Settings.Smoothness)
            else
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPos)
            end
        end
    end

    -- ESP Update
    for player, objects in pairs(ESP) do
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        if Settings.ESPEnabled and char and root and hum and hum.Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
            if onScreen then
                local color = (Settings.ESPTeamColor and player.Team) and player.Team.TeamColor.Color or Settings.ESPColor
                local head = char:FindFirstChild("Head")
                local headPos = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or pos
                
                local height = math.abs(pos.Y - headPos.Y) * 2.2
                local width = height * 0.6
                local size = Vector2.new(width, height)
                local position = Vector2.new(pos.X - width/2, pos.Y - height/2)

                if Settings.ESPBox then
                    objects.Box.Visible = true
                    objects.Box.Size = size
                    objects.Box.Position = position
                    objects.Box.Color = color
                else objects.Box.Visible = false end

                if Settings.ESPLine then
                    objects.Line.Visible = true
                    objects.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    objects.Line.To = Vector2.new(pos.X, pos.Y)
                    objects.Line.Color = color
                else objects.Line.Visible = false end

                if Settings.ESPName then
                    objects.Name.Visible = true
                    objects.Name.Text = player.Name
                    objects.Name.Position = Vector2.new(pos.X, position.Y - 16)
                    objects.Name.Color = color
                else objects.Name.Visible = false end

                if Settings.ESPDistance then
                    objects.Dist.Visible = true
                    objects.Dist.Text = math.floor((Camera.CFrame.Position - root.Position).Magnitude) .. "m"
                    objects.Dist.Position = Vector2.new(pos.X, position.Y + height + 2)
                    objects.Dist.Color = color
                else objects.Dist.Visible = false end
                
                continue
            end
        end
        -- Hide if not visible/enabled
        for _, obj in pairs(objects) do obj.Visible = false end
    end
end)

-- ============ WIND UI ============
local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
if WindUI then
    local Window = WindUI:CreateWindow({ Title = "Universal Script", Folder = "UniversalConfig", Icon = "solar:star-bold" })
    local MainTab = Window:Tab({ Title = "Main", Icon = "solar:settings-bold" })
    
    MainTab:Section({ Title = "Player" })
    MainTab:Toggle({ Title = "WalkSpeed", Desc = "Ativar WalkSpeed", Value = false, Callback = function(s) Settings.SpeedEnabled = s end })
    MainTab:Slider({ Title = "WalkSpeed Value", Desc = "Velocidade", Value = { Min = 16, Max = 200, Default = 16 }, Step = 1, Callback = function(v) Settings.WalkSpeed = v end })
    MainTab:Toggle({ Title = "Jump Power", Desc = "Ativar Jump Power", Value = false, Callback = function(s) Settings.JumpEnabled = s end })
    MainTab:Slider({ Title = "Jump Power Value", Desc = "Pulo", Value = { Min = 50, Max = 500, Default = 50 }, Step = 1, Callback = function(v) Settings.JumpPower = v end })

    MainTab:Section({ Title = "Aimbot" })
    MainTab:Toggle({ Title = "Aimbot", Value = false, Callback = function(s) Settings.AimbotEnabled = s end })
    MainTab:Slider({ Title = "Smoothness", Value = { Min = 0, Max = 99, Default = 50 }, Step = 1, Callback = function(v) Settings.Smoothness = v/100 end })
    MainTab:Slider({ Title = "FOV Radius", Value = { Min = 10, Max = 800, Default = 150 }, Step = 1, Callback = function(v) Settings.FOV = v end })
    MainTab:Toggle({ Title = "Show FOV", Value = true, Callback = function(s) Settings.ShowFOV = s end })
    MainTab:Colorpicker({ Title = "FOV Color", Default = Settings.FOVColor, Callback = function(c) Settings.FOVColor = c end })
    MainTab:Toggle({ Title = "Team Check", Value = true, Callback = function(s) Settings.TeamCheck = s end })
    MainTab:Toggle({ Title = "Wall Check", Value = true, Callback = function(s) Settings.WallCheck = s end })

    MainTab:Section({ Title = "Whitelist de Times" })
    for _, team in ipairs(Teams:GetTeams()) do
        MainTab:Toggle({ Title = team.Name, Value = false, Callback = function(s)
            if s then table.insert(Settings.WhitelistedTeams, team.Name)
            else local i = table.find(Settings.WhitelistedTeams, team.Name) if i then table.remove(Settings.WhitelistedTeams, i) end end
        end })
    end

    local VisualTab = Window:Tab({ Title = "Visual", Icon = "solar:eye-bold" })
    VisualTab:Section({ Title = "ESP" })
    VisualTab:Toggle({ Title = "ESP Master", Value = false, Callback = function(s) Settings.ESPEnabled = s end })
    VisualTab:Toggle({ Title = "ESP Box", Value = true, Callback = function(s) Settings.ESPBox = s end })
    VisualTab:Toggle({ Title = "ESP Line", Value = true, Callback = function(s) Settings.ESPLine = s end })
    VisualTab:Toggle({ Title = "ESP Nickname", Value = true, Callback = function(s) Settings.ESPName = s end })
    VisualTab:Toggle({ Title = "ESP Distance", Value = true, Callback = function(s) Settings.ESPDistance = s end })
    VisualTab:Toggle({ Title = "ESP Team Color", Value = false, Callback = function(s) Settings.ESPTeamColor = s s end })
    VisualTab:Colorpicker({ Title = "ESP Custom Color", Default = Settings.ESPColor, Callback = function(c) Settings.ESPColor = c end })

    local TPTab = Window:Tab({ Title = "Teleports", Icon = "solar:map-bold" })
    TPTab:Section({ Title = "Fuga De Tsunami de +1 Velocidade" })
    TPTab:Button({ Title = "Mundo 1", Callback = function() if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(2569.15, 13.88, 15.86) end end })
    TPTab:Button({ Title = "Mundo 2", Callback = function() if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(4365.58, -95.88, -534.55) end end })

    local CreditsTab = Window:Tab({ Title = "Credits", Icon = "solar:info-square-bold" })
    CreditsTab:Button({ Title = "Destroy GUI", Color = Color3.fromRGB(200, 50, 50), Callback = function()
        FOVCircle:Remove()
        for _, p in pairs(ESP) do for _, o in pairs(p) do o:Remove() end end
        Window:Destroy()
    end })
end
