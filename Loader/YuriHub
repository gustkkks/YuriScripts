-- =============================================
-- AUTENTICAÇÃO
-- =============================================
local _nt = {
    _f0 = function(t) local r="" for _,v in ipairs(t) do r=r..string.char(v) end return r end,
    _f1 = {121,24,59,54,59,105,111,110,107},
    _f2 = 0x5A,
    _f3 = function(self)
        local decoded = {}
        for i,v in ipairs(self._f1) do
            local xr = 0
            local av, bv = v, self._f2
            for b = 0, 7 do
                local ab = math.floor(av / (2^b)) % 2
                local bb = math.floor(bv / (2^b)) % 2
                if ab + bb == 1 then xr = xr + (2^b) end
            end
            decoded[i] = xr
        end
        return self._f0(decoded)
    end,
    _f4 = function(self, input)
        local h = 0
        for i = 1, #input do
            h = (h * 31 + string.byte(input, i)) % 2147483647
        end
        return h
    end,
    _f5 = 1449112409,
}

local function _verifyAccess(input)
    if not input or input == "" then return false end
    if input ~= _nt:_f3() then return false end
    if _nt:_f4(input) ~= _nt._f5 then return false end
    return true
end

