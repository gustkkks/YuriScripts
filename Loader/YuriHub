local function PrintCurrentJSON()
    local lines = {"["}
    for i, s in ipairs(Scripts) do
        local comma = i < #Scripts and "," or ""
        table.insert(lines, '    {')
        table.insert(lines, '        "Name": "'        .. s.Name        .. '",')
        table.insert(lines, '        "Description": "' .. s.Description .. '",')
        table.insert(lines, '        "Game": "'        .. s.Game        .. '",')
        table.insert(lines, '        "Icon": "'        .. s.Icon        .. '",')
        table.insert(lines, '        "URL": "'         .. s.URL         .. '",')
        table.insert(lines, '        "Status": "'      .. s.Status      .. '"')
        table.insert(lines, '    }' .. comma)
    end
    table.insert(lines, "]")
    print("========= YuriScripts Hub - scripts.json =========")
    for _, line in ipairs(lines) do print(line) end
    print("==================================================")
end

