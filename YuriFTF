-- Detecta o Beast (tem BeastPowers no character)
local function GetBeast()
    for _, player in ipairs(Players:GetPlayers()) do
        local char = player.Character
        if char and char:FindFirstChild("BeastPowers") then
            return player
        end
    end
    return nil
end

-- Limpa highlights pelo nome
local function ClearHighlights(name)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == name then
            obj:Destroy()
        end
    end
end

-- ESP: Computadores (PCs)
local function EnablePCsESP()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "ComputerTable" and not obj:FindFirstChild("PCHighlight") then
            local screen = obj:FindFirstChild("Screen")
            local hili = Instance.new("Highlight", obj)
            hili.Name = "PCHighlight"
            hili.OutlineTransparency = 1
            hili.FillColor = screen and screen.Color or Color3.fromRGB(0, 200, 255)
        end
    end
end

-- ESP: Pods de congelamento
local function EnablePodsESP()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "FreezePod" and not obj:FindFirstChild("PodsHighlight") then
            local hili = Instance.new("Highlight", obj)
            hili.Name = "PodsHighlight"
            hili.OutlineTransparency = 1
            hili.FillColor = Color3.fromRGB(0, 200, 255)
        end
    end
end

-- ESP: Saídas (ExitDoor)
local function EnableExitsESP()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "ExitDoor" and not obj:FindFirstChild("ExitsHighlight") then
            local hili = Instance.new("Highlight", obj)
            hili.Name = "ExitsHighlight"
            hili.OutlineTransparency = 1
            hili.FillColor = Color3.fromRGB(255, 255, 0)
        end
    end
end

-- ESP: Jogadores (verde = survivor, vermelho = beast)
local function EnablePlayersESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            if not char:FindFirstChild("PlayerHighlight") then
                local hili = Instance.new("Highlight", char)
                hili.Name = "PlayerHighlight"
                hili.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

                task.spawn(function()
                    while hili and hili.Parent do
                        local beast = GetBeast()
                        if beast and player == beast then
                            hili.FillColor = Color3.fromRGB(255, 0, 0)
                        else
                            hili.FillColor = Color3.fromRGB(0, 255, 0)
                        end
                        task.wait(0.1)
                    end
                end)
            end
        end
    end
end

-- Reaplica todos os ESPs ativos (chamado ao iniciar novo round)
local function ReaplicarESPs()
    if ESPState.PCs then
        ClearHighlights("PCHighlight")
        EnablePCsESP()
    end
    if ESPState.Pods then
        ClearHighlights("PodsHighlight")
        EnablePodsESP()
    end
    if ESPState.Exits then
        ClearHighlights("ExitsHighlight")
        EnableExitsESP()
    end
    if ESPState.Players then
        ClearHighlights("PlayerHighlight")
        EnablePlayersESP()
    end
end

-- =============================================
-- DETECTA NOVO ROUND (IsGameActive)
-- =============================================
pcall(function()
    local isGameActive = game.ReplicatedStorage:FindFirstChild("IsGameActive")
    if isGameActive then
        isGameActive.Changed:Connect(function()
            if isGameActive.Value == true then
                task.wait(2) -- aguarda o mapa carregar
                ReaplicarESPs()
            end
        end)
    end
end)

-- Também reaplica quando novos jogadores entram
Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        if ESPState.Players then
            task.wait(1)
            EnablePlayersESP()
        end
    end)
end)

-- =============================================
-- ANTI PC ERROR (hookmetamethod)
-- =============================================
local AntiFailState = false
local AntiFailHook  = nil

local function EnableAntiFail()
    if not hookmetamethod then return false end
    local ok = pcall(function()
        local OldNameCall
        OldNameCall = hookmetamethod(game, "__namecall", function(self, ...)
            local args = {...}
            local method = getnamecallmethod()
            if AntiFailState
                and method == "FireServer"
                and args[1] == "SetPlayerMinigameResult"
            then
                args[2] = true
            end
            return OldNameCall(self, unpack(args))
        end)
        AntiFailHook = OldNameCall
    end)
    return ok
end

-- =============================================
-- WALKSPEED COM LOCK
-- =============================================
local SpeedLocked   = false
local LockedSpeed   = 16
local SpeedLoop     = nil

local function StartSpeedLoop()
    if SpeedLoop then SpeedLoop:Disconnect() end
    SpeedLoop = RunService.Heartbeat:Connect(function()
        if not SpeedLocked then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = LockedSpeed
        end
    end)
end

StartSpeedLoop()

-- =============================================
-- FLASHLIGHT
-- =============================================
local FlashlightObj = nil

local function EnableFlashlight()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    if FlashlightObj then FlashlightObj:Destroy() end
    FlashlightObj = Instance.new("PointLight", root)
    FlashlightObj.Brightness = 2.5
    FlashlightObj.Range = 999999
end

local function DisableFlashlight()
    if FlashlightObj then
        FlashlightObj:Destroy()
        FlashlightObj = nil
    end
end

