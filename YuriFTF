-- ESTADO DO ESP
-- =============================================
local ESPState = { PCs=false, Pods=false, Exits=false, Players=false, Boxes=false }

-- =============================================
-- FUNÇÕES DE ESP
-- =============================================
local function GetBeast()
    for _, p in ipairs(Players:GetPlayers()) do
        local c = p.Character
        if c and c:FindFirstChild("BeastPowers") then return p end
    end
end

local function ClearHighlights(name)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == name then obj:Destroy() end
    end
end

local function EnablePCsESP()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "ComputerTable" and not obj:FindFirstChild("PCHighlight") then
            local h = Instance.new("Highlight", obj)
            h.Name = "PCHighlight"; h.OutlineTransparency = 1
            local s = obj:FindFirstChild("Screen")
            h.FillColor = s and s.Color or Color3.fromRGB(0, 200, 255)
        end
    end
end

local function EnablePodsESP()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "FreezePod" and not obj:FindFirstChild("PodsHighlight") then
            local h = Instance.new("Highlight", obj)
            h.Name = "PodsHighlight"; h.OutlineTransparency = 1
            h.FillColor = Color3.fromRGB(0, 200, 255)
        end
    end
end

local function EnableExitsESP()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "ExitDoor" and not obj:FindFirstChild("ExitsHighlight") then
            local h = Instance.new("Highlight", obj)
            h.Name = "ExitsHighlight"; h.OutlineTransparency = 1
            h.FillColor = Color3.fromRGB(255, 255, 0)
        end
    end
end

local function EnableBoxesESP()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj.Name == "HideBox" or obj.Name == "Locker" or obj.Name == "HidingSpot")
            and not obj:FindFirstChild("BoxHighlight")
        then
            local h = Instance.new("Highlight", obj)
            h.Name = "BoxHighlight"
            h.OutlineTransparency = 0
            h.OutlineColor = Color3.fromRGB(255, 165, 0)
            h.FillColor = Color3.fromRGB(255, 165, 0)
            h.FillTransparency = 0.6
        end
    end
end

local function EnablePlayersESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            if not char:FindFirstChild("PlayerHighlight") then
                local h = Instance.new("Highlight", char)
                h.Name = "PlayerHighlight"
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                task.spawn(function()
                    while h and h.Parent do
                        local beast = GetBeast()
                        h.FillColor = (beast and player == beast)
                            and Color3.fromRGB(255, 0, 0)
                            or  Color3.fromRGB(0, 255, 0)
                        task.wait(0.1)
                    end
                end)
            end
        end
    end
end

local function ReaplicarESPs()
    if ESPState.PCs     then ClearHighlights("PCHighlight");     EnablePCsESP()     end
    if ESPState.Pods    then ClearHighlights("PodsHighlight");   EnablePodsESP()    end
    if ESPState.Exits   then ClearHighlights("ExitsHighlight");  EnableExitsESP()   end
    if ESPState.Boxes   then ClearHighlights("BoxHighlight");    EnableBoxesESP()   end
    if ESPState.Players then ClearHighlights("PlayerHighlight"); EnablePlayersESP() end
end

-- Reaplica ao iniciar novo round
pcall(function()
    local iga = game.ReplicatedStorage:FindFirstChild("IsGameActive")
    if iga then
        iga.Changed:Connect(function()
            if iga.Value then task.wait(2); ReaplicarESPs() end
        end)
    end
end)

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        if ESPState.Players then task.wait(1); EnablePlayersESP() end
    end)
end)

-- =============================================
-- MOVIMENTO
-- =============================================
local SpeedLocked   = false
local LockedSpeed   = 16
local NoClipEnabled = false
local SpeedLoop     = nil
local NoClipLoop    = nil

SpeedLoop = RunService.Heartbeat:Connect(function()
    if not SpeedLocked then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed = LockedSpeed end
end)

NoClipLoop = RunService.Stepped:Connect(function()
    if not NoClipEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide then
            p.CanCollide = false
        end
    end
end)

-- =============================================
-- FLASHLIGHT
-- =============================================
local FlashlightObj = nil

local function EnableFlashlight()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    if FlashlightObj then FlashlightObj:Destroy() end
    FlashlightObj = Instance.new("PointLight", root)
    FlashlightObj.Brightness = 2.5
    FlashlightObj.Range = 999999
end

local function DisableFlashlight()
    if FlashlightObj then FlashlightObj:Destroy(); FlashlightObj = nil end
end

-- =============================================
-- ANTI PC ERROR
-- =============================================
local AntiFailState = false
local AntiFailHook  = nil

local function EnableAntiFail()
    if not hookmetamethod then return false end
    local ok = pcall(function()
        local Old
        Old = hookmetamethod(game, "__namecall", function(self, ...)
            local args = {...}
            local method = getnamecallmethod()
            if AntiFailState and method == "FireServer"
                and args[1] == "SetPlayerMinigameResult"
            then
                args[2] = true
            end
            return Old(self, unpack(args))
        end)
        AntiFailHook = Old
    end)
    return ok
end

